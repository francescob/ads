<div class="w-full max-w-lg">
  <div class="bg-white shadow-lg rounded-lg p-8">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-slate-900">Registrazione</h1>
      <p class="mt-2 text-sm text-slate-500">Crea un nuovo account</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), class: 'space-y-6') do |f| %>
      <% if resource.errors.any? %>
        <div class="rounded-md bg-red-50 p-4">
          <ul class="text-sm text-red-700 list-disc pl-5">
            <% resource.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, 'Nome', class: 'block text-sm font-medium text-slate-700' %>
          <%= f.text_field :first_name, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
        </div>
        <div>
          <%= f.label :last_name, 'Cognome', class: 'block text-sm font-medium text-slate-700' %>
          <%= f.text_field :last_name, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
        </div>
      </div>

      <div>
        <%= f.label :email, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>

      <div>
        <%= f.label :tax_code, 'Codice Fiscale', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :tax_code, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm font-mono uppercase' %>
      </div>

      <div>
        <%= f.label :account_type, 'Tipo Account', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.select :account_type, options_for_select([['Privato', 'private_account'], ['Professionista', 'professional'], ['Organizzazione', 'organization']]), {}, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>

      <div>
        <%= f.label :password, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.password_field :password, autocomplete: 'new-password', class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
        <p class="mt-1 text-xs text-slate-500">Minimo <%= @minimum_password_length %> caratteri</p>
      </div>

      <div>
        <%= f.label :password_confirmation, 'Conferma Password', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>

      <div>
        <%= f.submit 'Registrati', class: 'w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer', data: native_haptic_data(:success) %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <%= link_to 'Hai già un account? Accedi', new_user_session_path, class: 'text-sm text-blue-700 hover:text-blue-800 font-medium' %>
    </div>
  </div>
</div>