<%= native_navbar_tag(t('navigation.profile')) %>

<div>
  <%= page_header(t('navigation.profile')) %>

  <div class="max-w-2xl">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: 'space-y-6' }) do |f| %>
      <% if resource.errors.any? %>
        <div class="rounded-md bg-red-50 p-4">
          <ul class="text-sm text-red-700 list-disc pl-5">
            <% resource.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>

      <div class="bg-white shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-slate-900 mb-4">Dati Personali</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :first_name, 'Nome', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.text_field :first_name, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
          </div>
          <div>
            <%= f.label :last_name, 'Cognome', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.text_field :last_name, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
          </div>
          <div>
            <%= f.label :email, class: 'block text-sm font-medium text-slate-700' %>
            <%= f.email_field :email, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
          </div>
          <div>
            <%= f.label :tax_code, 'Codice Fiscale', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.text_field :tax_code, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm font-mono uppercase' %>
          </div>
          <div>
            <%= f.label :address, 'Indirizzo', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.text_field :address, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
          </div>
          <div>
            <%= f.label :phone, 'Telefono', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.text_field :phone, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
          </div>
          <div>
            <%= f.label :account_type, 'Tipo Account', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.select :account_type, options_for_select([['Privato', 'private_account'], ['Professionista', 'professional'], ['Organizzazione', 'organization']], resource.account_type), {}, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
          </div>
        </div>
      </div>

      <div class="bg-white shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-slate-900 mb-4">Modifica Password</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :password, 'Nuova Password', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.password_field :password, autocomplete: 'new-password', class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
            <p class="mt-1 text-xs text-slate-500">Lascia vuoto se non vuoi cambiarla</p>
          </div>
          <div>
            <%= f.label :password_confirmation, 'Conferma Nuova Password', class: 'block text-sm font-medium text-slate-700' %>
            <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
          </div>
        </div>
      </div>

      <div class="bg-white shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-slate-900 mb-4">Conferma Modifiche</h3>
        <div>
          <%= f.label :current_password, 'Password Attuale', class: 'block text-sm font-medium text-slate-700' %>
          <%= f.password_field :current_password, autocomplete: 'current-password', class: 'mt-1 block w-full max-w-md rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
          <p class="mt-1 text-xs text-slate-500">Inserisci la password attuale per confermare le modifiche</p>
        </div>
      </div>

      <div class="flex justify-end space-x-3">
        <%= f.submit 'Aggiorna Profilo', class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800 cursor-pointer', data: native_haptic_data(:success) %>
      </div>
    <% end %>

    <div class="mt-8 pt-6 border-t border-slate-200">
      <h3 class="text-lg font-medium text-red-600 mb-2">Elimina Account</h3>
      <p class="text-sm text-slate-500 mb-4">Questa azione è irreversibile.</p>
      <%= button_to 'Elimina il mio account', registration_path(resource_name), method: :delete, data: { turbo_confirm: 'Sei sicuro di voler eliminare il tuo account? Questa azione è irreversibile.', **native_haptic_data(:error) }, class: 'inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50' %>
    </div>
  </div>
</div>