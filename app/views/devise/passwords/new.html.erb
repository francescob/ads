<div class="w-full max-w-md">
  <div class="bg-white shadow-lg rounded-lg p-8">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-slate-900">Password dimenticata?</h1>
      <p class="mt-2 text-sm text-slate-500">Inserisci la tua email per ricevere le istruzioni di reset</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: 'space-y-6' }) do |f| %>
      <div>
        <%= f.label :email, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>

      <div>
        <%= f.submit 'Invia istruzioni', class: 'w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer' %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <%= link_to 'Torna al login', new_user_session_path, class: 'text-sm text-blue-700 hover:text-blue-800 font-medium' %>
    </div>
  </div>
</div>