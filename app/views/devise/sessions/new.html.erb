<div class="w-full max-w-md">
  <div class="bg-white shadow-lg rounded-lg p-8">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-slate-900">AdS Manager</h1>
      <p class="mt-2 text-sm text-slate-500">Accedi al tuo account</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: 'space-y-6') do |f| %>
      <div>
        <%= f.label :email, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>

      <div>
        <%= f.label :password, 'Password', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.password_field :password, autocomplete: 'current-password', class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>

      <% if devise_mapping.rememberable? %>
        <% if native_app? %>
          <%= f.hidden_field :remember_me, value: true %>
        <% else %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: 'rounded border-slate-300 text-blue-600 shadow-sm focus:ring-blue-500' %>
            <%= f.label :remember_me, 'Ricordami', class: 'ml-2 text-sm text-slate-600' %>
          </div>
        <% end %>
      <% end %>

      <div>
        <%= f.submit 'Accedi', class: 'w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer', data: native_haptic_data(:success) %>
      </div>
    <% end %>

    <div class="mt-6 text-center space-y-2">
      <%= link_to 'Registrati', new_user_registration_path, class: 'text-sm text-blue-700 hover:text-blue-800 font-medium' %>
      <span class="text-slate-300 mx-2">|</span>
      <%= link_to 'Password dimenticata?', new_user_password_path, class: 'text-sm text-blue-700 hover:text-blue-800 font-medium' %>
    </div>
  </div>
</div>