<%= form_with model: [@beneficiario, procedimento], class: "space-y-6" do |f| %>
  <%= render "shared/errors", record: procedimento %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :numero_rg, "Numero RG", class: "form-label" %>
        <%= f.text_field :numero_rg, class: "form-input" %>
      </div>
      <div>
        <%= f.label :tribunale, "Tribunale", class: "form-label" %>
        <%= f.text_field :tribunale, class: "form-input" %>
      </div>
      <div>
        <%= f.label :giudice_tutelare, "Giudice Tutelare", class: "form-label" %>
        <%= f.text_field :giudice_tutelare, class: "form-input" %>
      </div>
      <div>
        <%= f.label :stato, "Stato", class: "form-label" %>
        <%= f.select :stato, Procedimento::STATI.map { |s| [s.capitalize, s] }, { prompt: "Seleziona stato" }, class: "form-input" %>
      </div>
      <div>
        <%= f.label :data_apertura, "Data Apertura", class: "form-label" %>
        <%= f.date_field :data_apertura, class: "form-input" %>
      </div>
      <div>
        <%= f.label :data_chiusura, "Data Chiusura", class: "form-label" %>
        <%= f.date_field :data_chiusura, class: "form-input" %>
      </div>
    </div>
    <div>
      <%= f.label :note, "Note", class: "form-label" %>
      <%= f.text_area :note, rows: 3, class: "form-input" %>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Annulla", beneficiario_path(@beneficiario), class: "btn-secondary" %>
    <%= f.submit procedimento.new_record? ? "Crea Procedimento" : "Salva Modifiche", class: "btn-primary" %>
  </div>
<% end %>
