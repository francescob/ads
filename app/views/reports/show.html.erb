<% content_for(:breadcrumb_extra) { "Rendiconto #{@report.reference_year}" } %>
<div>
  <div class="sm:flex sm:items-center sm:justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Rendiconto <%= @report.reference_year %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= @beneficiary.full_name %> &mdash; <%= status_badge(@report.status) %></p>
    </div>
    <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
      <%= link_to t('reports.generate_pdf'), generate_pdf_report_path(@report), data: { turbo_method: :post }, class: 'inline-flex items-center px-3 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700' %>
      <% if @report.generated_pdf.attached? %>
        <%= link_to t('reports.download_pdf'), file_path(@report.generated_pdf.attachment, disposition: "inline"), data: { turbo: false }, target: '_blank', title: "Generato il #{l(@report.generated_pdf.created_at, format: :short)}", class: 'inline-flex items-center px-3 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700' %>
      <% end %>
      <%= link_to t('shared.export_csv'), exports_entries_csv_path(report_id: @report.id), class: 'inline-flex items-center px-3 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
      <%= link_to t('shared.edit'), edit_report_path(@report), class: 'inline-flex items-center px-3 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>

      <!-- Status workflow buttons -->
      <% @report.next_statuses.each do |next_status| %>
        <%= link_to t("reports.transitions.#{next_status}"), update_status_report_path(@report, status: next_status),
              data: { turbo_method: :patch }, class: 'inline-flex items-center px-3 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
      <% end %>
    </div>
  </div>

  <!-- Report Summary -->
  <%= turbo_frame_tag 'report-summary' do %>
    <%= render 'summary' %>
  <% end %>

  <%= render 'signature', report: @report %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-8">
    <!-- Income Section -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-slate-900"><%= t('income_entries.title') %></h2>
      </div>

      <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Data</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Descrizione</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-slate-500 uppercase">Importo</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody id="income_entries" class="divide-y divide-slate-100">
            <% @income_entries.each do |entry| %>
              <%= render partial: 'income_entries/income_entry', locals: { income_entry: entry } %>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="bg-slate-50">
              <td colspan="2" class="px-4 py-3 text-sm font-bold text-slate-900 text-right">Totale Entrate</td>
              <td class="px-4 py-3 text-sm font-bold text-right font-mono"><%= format_currency(@report.total_income) %></td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Inline income form -->
      <div class="mt-4">
        <%= turbo_frame_tag 'new_income_entry' do %>
          <div class="bg-slate-50 rounded-lg p-4 border border-dashed border-slate-300">
            <h4 class="text-sm font-medium text-slate-700 mb-3"><%= t('reports.add_income') %></h4>
            <%= render 'income_entries/form', income_entry: @income_entry, report: @report %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Expense Section -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-slate-900"><%= t('expense_entries.title') %></h2>
      </div>

      <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Data</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Descrizione</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-slate-500 uppercase">Importo</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody id="expense_entries" class="divide-y divide-slate-100">
            <% @expense_entries.each do |entry| %>
              <%= render partial: 'expense_entries/expense_entry', locals: { expense_entry: entry } %>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="bg-slate-50">
              <td colspan="2" class="px-4 py-3 text-sm font-bold text-slate-900 text-right">Totale Uscite</td>
              <td class="px-4 py-3 text-sm font-bold text-right font-mono"><%= format_currency(@report.total_expenses) %></td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Inline expense form -->
      <div class="mt-4">
        <%= turbo_frame_tag 'new_expense_entry' do %>
          <div class="bg-slate-50 rounded-lg p-4 border border-dashed border-slate-300">
            <h4 class="text-sm font-medium text-slate-700 mb-3"><%= t('reports.add_expense') %></h4>
            <%= render 'expense_entries/form', expense_entry: @expense_entry, report: @report %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>