<%= form_with(model: report, url: report.new_record? ? beneficiary_reports_path(@beneficiary) : report_path(report), class: 'space-y-6') do |f| %>
  <% if report.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">Errori:</h3>
          <ul class="mt-2 text-sm text-red-700 list-disc pl-5">
            <% report.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg p-6">
    <h3 class="text-lg font-medium text-slate-900 mb-4">Informazioni Rendiconto</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :appointment_id, 'Decreto di riferimento', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.collection_select :appointment_id, @appointments, :id, ->(a) { "#{a.decree_number} (#{a.appointment_date&.strftime('%d/%m/%Y')})" }, { include_blank: '-- Seleziona --' }, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :reference_year, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.number_field :reference_year, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm', min: 2000, max: 2100 %>
      </div>
      <div>
        <%= f.label :period_from, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.date_field :period_from, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :period_to, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.date_field :period_to, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :status, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.select :status, options_for_select([
          [t('enums.report.status.draft'), 'draft'],
          [t('enums.report.status.completed'), 'completed'],
          [t('enums.report.status.filed'), 'filed'],
          [t('enums.report.status.approved'), 'approved']
        ], report.status), {}, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :filing_date, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.date_field :filing_date, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :court_notes, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_area :court_notes, rows: 3, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to t('shared.cancel'), report.new_record? ? beneficiary_reports_path(@beneficiary) : report_path(report), class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
    <%= f.submit t('shared.save'), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800 cursor-pointer' %>
  </div>
<% end %>