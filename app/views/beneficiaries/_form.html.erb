<%= form_with(model: [@beneficiary.user, beneficiary].compact.last, url: beneficiary.new_record? ? beneficiaries_path : beneficiary_path(beneficiary), class: 'space-y-8') do |f| %>
  <% if beneficiary.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-6">
      <div class="flex">
        <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">Si sono verificati <%= beneficiary.errors.count %> errori:</h3>
          <ul class="mt-2 text-sm text-red-700 list-disc pl-5">
            <% beneficiary.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Personal Data -->
  <div class="bg-white shadow rounded-lg p-6">
    <h3 class="text-lg font-medium text-slate-900 mb-4">Dati Anagrafici</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :first_name, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :first_name, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :last_name, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :last_name, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :tax_code, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :tax_code, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm font-mono uppercase' %>
      </div>
      <div>
        <%= f.label :gender, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.select :gender, options_for_select([[t('enums.beneficiary.gender.male'), 'male'], [t('enums.beneficiary.gender.female'), 'female']], beneficiary.gender), { include_blank: '-- Seleziona --' }, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :date_of_birth, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.date_field :date_of_birth, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :place_of_birth, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :place_of_birth, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
    </div>
  </div>

  <!-- Address -->
  <div class="bg-white shadow rounded-lg p-6">
    <h3 class="text-lg font-medium text-slate-900 mb-4">Indirizzo</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="md:col-span-2">
        <%= f.label :street_address, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :street_address, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :city, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :city, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :province, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :province, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm', maxlength: 2 %>
      </div>
      <div>
        <%= f.label :zip_code, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :zip_code, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm', maxlength: 5 %>
      </div>
      <div>
        <%= f.label :status, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.select :status, options_for_select([[t('enums.beneficiary.status.active'), 'active'], [t('enums.beneficiary.status.suspended'), 'suspended'], [t('enums.beneficiary.status.closed'), 'closed']], beneficiary.status), {}, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
    </div>
  </div>

  <!-- Medical Info -->
  <div class="bg-white shadow rounded-lg p-6">
    <h3 class="text-lg font-medium text-slate-900 mb-4">Informazioni Sanitarie</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="md:col-span-2">
        <%= f.label :health_condition, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_area :health_condition, rows: 3, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :diagnosis, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_area :diagnosis, rows: 3, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :referring_doctor, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :referring_doctor, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :doctor_contact, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :doctor_contact, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :notes, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_area :notes, rows: 3, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
    </div>
  </div>

  <!-- Submit -->
  <div class="flex justify-end space-x-3">
    <%= link_to t('shared.cancel'), beneficiaries_path, class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
    <%= f.submit t('shared.save'), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800 cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500', data: native_haptic_data(:success) %>
  </div>
<% end %>