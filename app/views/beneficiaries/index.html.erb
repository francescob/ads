<%= native_navbar_tag(t('beneficiaries.title')) %>

<div>
  <%= page_header(t('beneficiaries.title')) do %>
    <%= link_to t('beneficiaries.new'), new_beneficiary_path, class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500', data: native_haptic_data(:success) %>
  <% end %>

  <!-- Search -->
  <div class="bg-white shadow rounded-lg mb-6 p-4">
    <%= search_form_for @q, url: beneficiaries_path, class: 'flex flex-wrap gap-4 items-end' do |f| %>
      <div class="flex-1 min-w-[200px]">
        <%= f.label :first_name_or_last_name_or_tax_code_cont, t('beneficiaries.search_placeholder'), class: 'block text-sm font-medium text-slate-700 mb-1' %>
        <%= f.search_field :first_name_or_last_name_or_tax_code_cont, class: 'block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm', placeholder: t('beneficiaries.search_placeholder') %>
      </div>
      <div class="min-w-[150px]">
        <%= f.label :status_eq, t('activerecord.attributes.beneficiary.status'), class: 'block text-sm font-medium text-slate-700 mb-1' %>
        <%= f.select :status_eq, options_for_select([['', ''], [t('enums.beneficiary.status.active'), 0], [t('enums.beneficiary.status.suspended'), 1], [t('enums.beneficiary.status.closed'), 2]], params.dig(:q, :status_eq)), {}, class: 'block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div class="flex space-x-2">
        <%= f.submit t('shared.search'), class: 'inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800 cursor-pointer' %>
        <%= link_to t('shared.reset'), beneficiaries_path, class: 'inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
      </div>
    <% end %>
  </div>

  <% if @beneficiaries.any? %>
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider"><%= t('activerecord.attributes.beneficiary.last_name') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider"><%= t('activerecord.attributes.beneficiary.first_name') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider"><%= t('activerecord.attributes.beneficiary.tax_code') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider"><%= t('activerecord.attributes.beneficiary.city') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider"><%= t('activerecord.attributes.beneficiary.status') %></th>
            <th class="px-6 py-3"></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-slate-100">
          <% @beneficiaries.each do |beneficiary| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">
                <%= link_to beneficiary.last_name, beneficiary_path(beneficiary), class: 'text-blue-700 hover:text-blue-800' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500"><%= beneficiary.first_name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500 font-mono"><%= beneficiary.tax_code %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500"><%= beneficiary.city %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= status_badge(beneficiary.status) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <%= link_to t('shared.edit'), edit_beneficiary_path(beneficiary), class: 'text-blue-700 hover:text-blue-800 font-medium' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      <%= paginate @beneficiaries %>
    </div>
  <% else %>
    <%= render 'shared/empty_state', message: t('beneficiaries.no_beneficiaries'), action_path: new_beneficiary_path, action_label: t('beneficiaries.new') %>
  <% end %>
</div>