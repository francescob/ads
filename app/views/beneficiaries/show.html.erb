                  <td class="px-6 py-4 text-right text-sm">
                    <%= link_to t('shared.edit'), edit_communication_path(comm), class: 'text-blue-700 hover:text-blue-800 font-medium' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-500 text-center py-8"><%= t('communications.no_communications') %></p>
      <% end %>
