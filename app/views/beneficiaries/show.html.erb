                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                        <svg class="mr-1 h-2 w-2 fill-current" viewBox="0 0 8 8">
                          <circle cx="4" cy="4" r="3" />
                        </svg>
                        <%= t('recurring_expenses.status.active') %>
                      </span>
                    <% elsif expense.active? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        <%= t('recurring_expenses.status.scheduled') %>
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
                        <%= t('recurring_expenses.status.inactive') %>
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-right text-sm">
                    <%= link_to t('shared.edit'), edit_recurring_expense_path(expense), class: 'text-blue-700 hover:text-blue-800 font-medium' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-500 text-center py-8"><%= t('recurring_expenses.no_recurring_expenses') %></p>
      <% end %>
