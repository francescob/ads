            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.hearing.hearing_date') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.hearing.court') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.hearing.subject') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.hearing.outcome') %></th>
                <th class="px-6 py-3"></th>
