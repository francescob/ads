    <!-- Documents Tab -->
    <div data-tabs-target="panel" data-tab="documents" class="hidden">
      <div class="mb-4 flex justify-end">
        <%= link_to t('documents.new'), new_beneficiary_document_path(@beneficiary), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800' %>
      </div>
      <% if @documents.any? %>
        <div class="bg-white shadow rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.document.title') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.document.document_type') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.document.expiry_date') %></th>
                <th class="px-6 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @documents.each do |doc| %>
                <tr class="hover:bg-slate-50 <%= 'bg-red-50' if doc.expired? %>">
                  <td class="px-6 py-4 text-sm font-medium"><%= link_to doc.title, document_path(doc), class: 'text-blue-700 hover:text-blue-800' %></td>
                  <td class="px-6 py-4 text-sm"><%= t("activerecord.enums.document.document_type.#{doc.document_type}") %></td>
                  <td class="px-6 py-4 text-sm text-slate-500">
                    <%= doc.expiry_date&.strftime('%d/%m/%Y') || '-' %>
                    <% if doc.expired? %>
                      <span class="ml-1 text-xs text-red-600 font-medium">Scaduto</span>
                    <% elsif doc.expiring_soon? %>
                      <span class="ml-1 text-xs text-orange-600 font-medium">In scadenza</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-right text-sm">
                    <% if doc.file.attached? %>
                      <%= link_to 'Download', rails_blob_path(doc.file, disposition: 'attachment'), class: 'text-blue-700 hover:text-blue-800 font-medium mr-3' %>
                    <% end %>
                    <%= link_to t('shared.edit'), edit_document_path(doc), class: 'text-blue-700 hover:text-blue-800 font-medium' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-500 text-center py-8"><%= t('documents.no_documents') %></p>
      <% end %>
    </div>

