<%= native_navbar_tag(@beneficiary.full_name) %>

<div>
  <div class="sm:flex sm:items-center sm:justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900"><%= @beneficiary.full_name %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= @beneficiary.tax_code %> &mdash; <%= status_badge(@beneficiary.status) %></p>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <%= link_to t('shared.edit'), edit_beneficiary_path(@beneficiary), class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
      <%= link_to t('shared.delete'), beneficiary_path(@beneficiary), data: { turbo_method: :delete, turbo_confirm: t('shared.confirm_delete'), **native_haptic_data(:error) }, class: 'inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50' %>
    </div>
  </div>

  <!-- Tabs -->
  <div data-controller="tabs">
    <div class="border-b border-slate-200 mb-6">
      <nav class="-mb-px flex space-x-8 overflow-x-auto" aria-label="Tabs">
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="profile" class="tab-btn border-blue-500 text-blue-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"><%= t('beneficiaries.tabs.profile') %></button>
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="appointments" class="tab-btn border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"><%= t('beneficiaries.tabs.appointments') %> (<%= @appointments.count %>)</button>
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="reports" class="tab-btn border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"><%= t('beneficiaries.tabs.reports') %> (<%= @reports.count %>)</button>
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="assets" class="tab-btn border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"><%= t('beneficiaries.tabs.assets') %> (<%= @assets.count %>)</button>
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="properties" class="tab-btn border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">Immobili (<%= @properties.count %>)</button>
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="liabilities" class="tab-btn border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"><%= t('beneficiaries.tabs.liabilities') %> (<%= @liabilities.count %>)</button>
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="recurring_incomes" class="tab-btn border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"><%= t('beneficiaries.tabs.recurring_incomes') %> (<%= @recurring_incomes.count %>)</button>
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="recurring_expenses" class="tab-btn border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"><%= t('beneficiaries.tabs.recurring_expenses') %> (<%= @recurring_expenses.count %>)</button>
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="deadlines" class="tab-btn border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"><%= t('beneficiaries.tabs.deadlines') %> (<%= @deadlines.count %>)</button>
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="hearings" class="tab-btn border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"><%= t('beneficiaries.tabs.hearings') %> (<%= @hearings.count %>)</button>
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="documents" class="tab-btn border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"><%= t('beneficiaries.tabs.documents') %> (<%= @documents.count %>)</button>
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="communications" class="tab-btn border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"><%= t('beneficiaries.tabs.communications') %> (<%= @communications.count %>)</button>
        <button data-tabs-target="tab" data-action="click->tabs#switch" data-tab="contacts" class="tab-btn border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"><%= t('beneficiaries.tabs.contacts') %> (<%= @contacts.count %>)</button>
      </nav>
    </div>

    <!-- Profile Tab -->
    <div data-tabs-target="panel" data-tab="profile">
      <div class="bg-white shadow rounded-lg p-6">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.beneficiary.date_of_birth') %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @beneficiary.date_of_birth&.strftime('%d/%m/%Y') || '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.beneficiary.place_of_birth') %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @beneficiary.place_of_birth || '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.beneficiary.gender') %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @beneficiary.gender ? t("activerecord.enums.beneficiary.gender.#{@beneficiary.gender}") : '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500">Indirizzo</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= [@beneficiary.street_address, @beneficiary.city, @beneficiary.province, @beneficiary.zip_code].compact_blank.join(', ') %></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.beneficiary.health_condition') %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @beneficiary.health_condition || '-' %></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.beneficiary.diagnosis') %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @beneficiary.diagnosis || '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.beneficiary.referring_doctor') %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @beneficiary.referring_doctor || '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.beneficiary.doctor_contact') %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @beneficiary.doctor_contact || '-' %></dd>
          </div>
          <% if @beneficiary.notes.present? %>
            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.beneficiary.notes') %></dt>
              <dd class="mt-1 text-sm text-slate-900"><%= simple_format(@beneficiary.notes) %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>

    <!-- Appointments Tab -->
    <div data-tabs-target="panel" data-tab="appointments" class="hidden">
      <div class="mb-4 flex justify-end">
        <%= link_to t('appointments.new'), new_beneficiary_appointment_path(@beneficiary), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800' %>
      </div>
      <% if @appointments.any? %>
        <div class="bg-white shadow rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.appointment.decree_number') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.appointment.court') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.appointment.appointment_date') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.appointment.mandate_expiry_date') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.appointment.appointment_type') %></th>
                <th class="px-6 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @appointments.each do |appt| %>
                <tr class="hover:bg-slate-50">
                  <td class="px-6 py-4 text-sm font-medium"><%= link_to appt.decree_number, appointment_path(appt), class: 'text-blue-700 hover:text-blue-800' %></td>
                  <td class="px-6 py-4 text-sm text-slate-500"><%= appt.court %></td>
                  <td class="px-6 py-4 text-sm text-slate-500"><%= appt.appointment_date&.strftime('%d/%m/%Y') %></td>
                  <td class="px-6 py-4 text-sm text-slate-500"><%= appt.mandate_expiry_date&.strftime('%d/%m/%Y') %></td>
                  <td class="px-6 py-4 text-sm"><%= status_badge(appt.appointment_type) %></td>
                  <td class="px-6 py-4 text-right text-sm">
                    <%= link_to t('shared.edit'), edit_appointment_path(appt), class: 'text-blue-700 hover:text-blue-800 font-medium' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-500 text-center py-8"><%= t('appointments.no_appointments') %></p>
      <% end %>
    </div>

    <!-- Reports Tab -->
    <div data-tabs-target="panel" data-tab="reports" class="hidden">
      <div class="mb-4 flex justify-end">
        <%= link_to t('reports.new'), new_beneficiary_report_path(@beneficiary), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800' %>
      </div>
      <% if @reports.any? %>
        <div class="bg-white shadow rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Anno</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Periodo</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Stato</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase">Saldo Finale</th>
                <th class="px-6 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @reports.each do |report| %>
                <tr class="hover:bg-slate-50">
                  <td class="px-6 py-4 text-sm font-medium"><%= link_to report.reference_year, report_path(report), class: 'text-blue-700 hover:text-blue-800' %></td>
                  <td class="px-6 py-4 text-sm text-slate-500"><%= report.period_from.strftime('%d/%m/%Y') %> - <%= report.period_to.strftime('%d/%m/%Y') %></td>
                  <td class="px-6 py-4"><%= status_badge(report.status) %></td>
                  <td class="px-6 py-4 text-sm text-right font-mono"><%= format_currency(report.closing_balance) %></td>
                  <td class="px-6 py-4 text-right text-sm">
                    <%= link_to t('shared.edit'), edit_report_path(report), class: 'text-blue-700 hover:text-blue-800 font-medium' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-500 text-center py-8"><%= t('reports.no_reports') %></p>
      <% end %>
    </div>

    <!-- Assets Tab -->
    <div data-tabs-target="panel" data-tab="assets" class="hidden">
      <div class="mb-4 flex justify-between items-center">
        <p class="text-sm font-medium text-slate-700"><%= t('assets.net_total') %>: <span class="text-lg font-bold text-slate-900"><%= format_currency(@beneficiary.net_asset_total) %></span></p>
        <div class="flex space-x-2">
          <% if @beneficiary.asset_inventory_pdf.attached? %>
            <div class="flex flex-col items-end">
              <%= link_to t('assets.download_pdf'), download_asset_inventory_beneficiary_path(@beneficiary), class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
              <span class="text-xs text-slate-500 mt-1">
                Generato il <%= l(@beneficiary.asset_inventory_pdf.created_at, format: :short) %>
              </span>
            </div>
          <% end %>
          <%= link_to t('assets.generate_pdf'), generate_asset_inventory_beneficiary_path(@beneficiary), data: { turbo_method: :post }, class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
          <%= link_to t('assets.new'), new_beneficiary_asset_path(@beneficiary), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800' %>
        </div>
      </div>
      <% if @assets.any? %>
        <div class="bg-white shadow rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.asset.asset_type') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.asset.description') %></th>
                <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.asset.current_value') %></th>
                <th class="px-6 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @assets.each do |asset| %>
                <tr class="hover:bg-slate-50">
                  <td class="px-6 py-4 text-sm"><%= t("activerecord.enums.asset.asset_type.#{asset.asset_type}") %></td>
                  <td class="px-6 py-4 text-sm font-medium"><%= link_to asset.description, asset_path(asset), class: 'text-blue-700 hover:text-blue-800' %></td>
                  <td class="px-6 py-4 text-sm text-right font-mono"><%= format_currency(asset.current_value) %></td>
                  <td class="px-6 py-4 text-right text-sm">
                    <%= link_to t('shared.edit'), edit_asset_path(asset), class: 'text-blue-700 hover:text-blue-800 font-medium' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-500 text-center py-8"><%= t('assets.no_assets') %></p>
      <% end %>
    </div>

    <!-- Properties Tab -->
    <div data-tabs-target="panel" data-tab="properties" class="hidden">
      <div class="mb-4 flex justify-between items-center">
        <p class="text-sm font-medium text-slate-700">Valore Totale Immobili: <span class="text-lg font-bold text-slate-900"><%= format_currency(@beneficiary.total_properties_value) %></span></p>
        <%= link_to 'Nuovo Immobile', new_beneficiary_property_path(@beneficiary), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800' %>
      </div>
      <% if @properties.any? %>
        <div class="bg-white shadow rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Tipo</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Descrizione</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Indirizzo</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Dati Catastali</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase">Valore Attuale</th>
                <th class="px-6 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @properties.each do |property| %>
                <tr class="hover:bg-slate-50">
                  <td class="px-6 py-4 text-sm"><%= property.property_type.humanize %></td>
                  <td class="px-6 py-4 text-sm font-medium"><%= link_to property.description, property_path(property), class: 'text-blue-700 hover:text-blue-800' %></td>
                  <td class="px-6 py-4 text-sm text-slate-600">
                    <%= property.city.present? ? "#{property.city} (#{property.province})" : "-" %>
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-600">
                    <% if property.cadastral_reference.present? %>
                      <span class="text-xs"><%= property.cadastral_reference %></span>
                    <% else %>
                      -
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-sm text-right font-mono"><%= format_currency(property.current_value) %></td>
                  <td class="px-6 py-4 text-right text-sm">
                    <%= link_to t('shared.edit'), edit_property_path(property), class: 'text-blue-700 hover:text-blue-800 font-medium' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-500 text-center py-8">Nessun immobile registrato</p>
      <% end %>
    </div>

    <!-- Liabilities Tab -->
    <div data-tabs-target="panel" data-tab="liabilities" class="hidden">
      <div class="mb-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <p class="text-sm font-medium text-blue-900"><%= t('liabilities.total_assets') %></p>
            <p class="text-2xl font-bold text-blue-700"><%= format_currency(@beneficiary.total_assets) %></p>
          </div>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <p class="text-sm font-medium text-red-900"><%= t('liabilities.total_liabilities') %></p>
            <p class="text-2xl font-bold text-red-700"><%= format_currency(@beneficiary.total_liabilities) %></p>
          </div>
          <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <p class="text-sm font-medium text-green-900"><%= t('liabilities.net_worth') %></p>
            <p class="text-2xl font-bold <%= @beneficiary.net_worth >= 0 ? 'text-green-700' : 'text-red-700' %>">
              <%= format_currency(@beneficiary.net_worth) %>
            </p>
          </div>
        </div>
        <div class="flex justify-end">
          <%= link_to t('liabilities.new'), new_beneficiary_liability_path(@beneficiary), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800' %>
        </div>
      </div>
      <% if @liabilities.any? %>
        <div class="bg-white shadow rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.liability.liability_type') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.liability.description') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.liability.creditor') %></th>
                <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.liability.remaining_balance') %></th>
                <th class="px-6 py-3 text-center text-xs font-medium text-slate-500 uppercase"><%= t('liabilities.status') %></th>
                <th class="px-6 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @liabilities.each do |liability| %>
                <tr class="hover:bg-slate-50">
                  <td class="px-6 py-4 text-sm"><%= t("activerecord.enums.liability.liability_type.#{liability.liability_type}") %></td>
                  <td class="px-6 py-4 text-sm font-medium"><%= link_to liability.description, liability_path(liability), class: 'text-blue-700 hover:text-blue-800' %></td>
                  <td class="px-6 py-4 text-sm"><%= liability.creditor %></td>
                  <td class="px-6 py-4 text-sm text-right font-mono <%= liability.remaining_balance.nil? ? 'text-slate-400' : (liability.paid_off? ? 'text-green-600' : 'text-red-600') %>">
                    <%= format_currency(liability.remaining_balance) %>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <% if liability.paid_off? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        <%= t('liabilities.paid_off') %>
                      </span>
                    <% elsif liability.percentage_paid.present? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        <%= format_percentage(liability.percentage_paid, precision: 0) %>
                      </span>
                    <% else %>
                      <span class="text-xs text-slate-400">-</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-right text-sm">
                    <%= link_to t('shared.edit'), edit_liability_path(liability), class: 'text-blue-700 hover:text-blue-800 font-medium' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-500 text-center py-8"><%= t('liabilities.no_liabilities') %></p>
      <% end %>
    </div>

    <!-- Recurring Incomes Tab -->
    <div data-tabs-target="panel" data-tab="recurring_incomes" class="hidden">
      <div class="mb-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <p class="text-sm font-medium text-blue-900"><%= t('recurring_incomes.total_annual') %></p>
            <p class="text-2xl font-bold text-blue-700"><%= format_currency(@beneficiary.total_annual_recurring_income) %></p>
          </div>
