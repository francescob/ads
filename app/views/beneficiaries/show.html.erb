                  <td class="px-6 py-4 text-sm font-medium"><%= hearing.hearing_date.strftime('%d/%m/%Y %H:%M') %></td>
                  <td class="px-6 py-4 text-sm text-slate-500"><%= hearing.court %></td>
                  <td class="px-6 py-4 text-sm text-slate-500"><%= hearing.subject %></td>
                  <td class="px-6 py-4 text-sm text-slate-500"><%= truncate(hearing.outcome, length: 50) %></td>
