            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.recurring_income.income_type') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.recurring_income.description') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.recurring_income.frequency') %></th>
                <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase"><%= t('activerecord.attributes.recurring_income.amount') %></th>
                <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase"><%= t('recurring_incomes.annual_amount') %></th>
                <th class="px-6 py-3 text-center text-xs font-medium text-slate-500 uppercase"><%= t('recurring_incomes.status_label') %></th>
                <th class="px-6 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @recurring_incomes.each do |income| %>
                <tr class="hover:bg-slate-50">
                  <td class="px-6 py-4 text-sm"><%= t("activerecord.enums.recurring_income.income_type.#{income.income_type}") %></td>
                  <td class="px-6 py-4 text-sm font-medium"><%= link_to income.description, recurring_income_path(income), class: 'text-blue-700 hover:text-blue-800' %></td>
                  <td class="px-6 py-4 text-sm"><%= t("activerecord.enums.recurring_income.frequency.#{income.frequency}") %></td>
                  <td class="px-6 py-4 text-sm text-right font-mono"><%= format_currency(income.amount) %></td>
                  <td class="px-6 py-4 text-sm text-right font-mono font-semibold"><%= format_currency(income.annual_amount) %></td>
                  <td class="px-6 py-4 text-center">
                    <% if income.currently_active? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        <svg class="mr-1 h-2 w-2 fill-current" viewBox="0 0 8 8">
                          <circle cx="4" cy="4" r="3" />
                        </svg>
                        <%= t('recurring_incomes.status.active') %>
                      </span>
                    <% elsif income.active? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        <%= t('recurring_incomes.status.scheduled') %>
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
                        <%= t('recurring_incomes.status.inactive') %>
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-right text-sm">
                    <%= link_to t('shared.edit'), edit_recurring_income_path(income), class: 'text-blue-700 hover:text-blue-800 font-medium' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-500 text-center py-8"><%= t('recurring_incomes.no_recurring_incomes') %></p>
      <% end %>
    </div>

