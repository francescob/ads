    <!-- Deadlines Tab -->
    <div data-tabs-target="panel" data-tab="deadlines" class="hidden">
      <div class="mb-4 flex justify-end">
        <%= link_to t('deadlines.new'), new_beneficiary_deadline_path(@beneficiary), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800' %>
