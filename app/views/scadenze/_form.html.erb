<%= form_with model: [@beneficiario, @procedimento, scadenza], class: "space-y-6" do |f| %>
  <%= render "shared/errors", record: scadenza %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="sm:col-span-2">
        <%= f.label :titolo, "Titolo *", class: "form-label" %>
        <%= f.text_field :titolo, class: "form-input" %>
      </div>
      <div>
        <%= f.label :data_scadenza, "Data Scadenza *", class: "form-label" %>
        <%= f.date_field :data_scadenza, class: "form-input" %>
      </div>
      <div>
        <%= f.label :tipo, "Tipo", class: "form-label" %>
        <%= f.select :tipo, Scadenza::TIPI.map { |t| [t.capitalize, t] }, { prompt: "Seleziona tipo" }, class: "form-input" %>
      </div>
      <div>
        <%= f.label :ricorrenza, "Si ripete", class: "form-label" %>
        <%= f.select :ricorrenza, opzioni(Scadenza::RICORRENZE.keys), { include_blank: "No" }, class: "form-input" %>
      </div>
    </div>
    <div>
      <%= f.label :descrizione, "Descrizione", class: "form-label" %>
      <%= f.text_area :descrizione, rows: 3, class: "form-input" %>
    </div>
    <div class="flex items-center space-x-2">
      <%= f.check_box :completata, class: "h-4 w-4 text-blue-600 border-gray-300 rounded" %>
      <%= f.label :completata, "Completata", class: "text-sm font-medium text-gray-700" %>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Annulla", beneficiario_procedimento_path(@beneficiario, @procedimento), class: "btn-secondary" %>
    <%= f.submit scadenza.new_record? ? "Crea Scadenza" : "Salva Modifiche", class: "btn-primary" %>
  </div>
<% end %>
