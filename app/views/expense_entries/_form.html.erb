<%= form_with(model: [report, expense_entry].compact, url: expense_entry.new_record? ? report_expense_entries_path(report) : expense_entry_path(expense_entry), class: 'space-y-3') do |f| %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <div>
      <%= f.label :entry_date, 'Data', class: 'block text-xs font-medium text-slate-600' %>
      <%= f.date_field :entry_date, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm', value: expense_entry.entry_date || Date.current %>
    </div>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :description, 'Descrizione', class: 'block text-xs font-medium text-slate-600' %>
      <%= f.text_field :description, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
    </div>
    <div>
      <%= f.label :amount, 'Importo', class: 'block text-xs font-medium text-slate-600' %>
      <%= f.number_field :amount, step: '0.01', min: '0', class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
    </div>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <div>
      <%= f.label :category, 'Categoria', class: 'block text-xs font-medium text-slate-600' %>
      <%= f.select :category, options_for_select([
        [t('enums.expense_entry.category.medical'), 'medical'],
        [t('enums.expense_entry.category.food'), 'food'],
        [t('enums.expense_entry.category.housing'), 'housing'],
        [t('enums.expense_entry.category.clothing'), 'clothing'],
        [t('enums.expense_entry.category.taxes'), 'taxes'],
        [t('enums.expense_entry.category.ordinary'), 'ordinary'],
        [t('enums.expense_entry.category.extraordinary'), 'extraordinary'],
        [t('enums.expense_entry.category.other_expense'), 'other_expense']
      ], expense_entry.category), {}, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
    </div>
    <div>
      <%= f.label :supplier, 'Fornitore', class: 'block text-xs font-medium text-slate-600' %>
      <%= f.text_field :supplier, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
    </div>
    <div>
      <%= f.label :receipt_number, 'N. Ricevuta', class: 'block text-xs font-medium text-slate-600' %>
      <%= f.text_field :receipt_number, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
    </div>
    <div>
      <%= f.label :receipt_file, 'Ricevuta (file)', class: 'block text-xs font-medium text-slate-600' %>
      <%= f.file_field :receipt_file, class: 'mt-1 block w-full text-sm text-slate-500 file:mr-4 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100' %>
    </div>
  </div>
  <% if expense_entry.errors.any? %>
    <div class="text-sm text-red-600">
      <% expense_entry.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>
  <div class="flex justify-end">
    <%= f.submit expense_entry.new_record? ? 'Aggiungi Uscita' : 'Aggiorna', class: 'inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 cursor-pointer' %>
  </div>
<% end %>