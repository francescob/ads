<%= turbo_stream.append "expense_entries" do %>
  <%= render partial: 'expense_entries/expense_entry', locals: { expense_entry: @expense_entry } %>
<% end %>

<%= turbo_stream.replace "new_expense_entry" do %>
  <%= turbo_frame_tag 'new_expense_entry' do %>
    <div class="bg-slate-50 rounded-lg p-4 border border-dashed border-slate-300">
      <h4 class="text-sm font-medium text-slate-700 mb-3"><%= t('reports.add_expense') %></h4>
      <%= render 'expense_entries/form', expense_entry: @report.expense_entries.build, report: @report %>
    </div>
  <% end %>
<% end %>

<%= turbo_stream.replace "report-summary" do %>
  <%= turbo_frame_tag 'report-summary' do %>
    <%= render 'reports/summary' %>
  <% end %>
<% end %>