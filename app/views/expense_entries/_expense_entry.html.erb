<tr id="<%= dom_id(expense_entry) %>">
  <td class="px-4 py-3 text-sm text-slate-500"><%= expense_entry.entry_date.strftime('%d/%m/%Y') %></td>
  <td class="px-4 py-3 text-sm text-slate-900">
    <%= expense_entry.description %>
    <span class="block text-xs text-slate-400"><%= t("activerecord.enums.expense_entry.category.#{expense_entry.category}") %> <% if expense_entry.supplier.present? %>&mdash; <%= expense_entry.supplier %><% end %></span>
  </td>
  <td class="px-4 py-3 text-sm text-right font-mono text-red-700"><%= format_currency(expense_entry.amount) %></td>
  <td class="px-4 py-3 text-right text-sm space-x-2">
    <%= link_to t('shared.edit'), edit_expense_entry_path(expense_entry), class: 'text-blue-700 hover:text-blue-800' %>
    <%= link_to t('shared.delete'), expense_entry_path(expense_entry), data: { turbo_method: :delete, turbo_confirm: t('shared.confirm_delete') }, class: 'text-red-600 hover:text-red-800' %>
  </td>
</tr>