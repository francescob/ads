<% content_for(:breadcrumb_extra) { t('assets.title') } %>
<div>
  <div class="sm:flex sm:items-center sm:justify-between mb-6">
    <h1 class="text-2xl font-bold text-slate-900"><%= @asset.description %></h1>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <%= link_to t('shared.edit'), edit_asset_path(@asset), class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
      <%= link_to t('shared.delete'), asset_path(@asset), data: { turbo_method: :delete, turbo_confirm: t('shared.confirm_delete') }, class: 'inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50' %>
    </div>
  </div>

  <div class="bg-white shadow rounded-lg p-6">
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
      <div>
        <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.asset.asset_type') %></dt>
        <dd class="mt-1 text-sm text-slate-900"><%= t("activerecord.enums.asset.asset_type.#{@asset.asset_type}") %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.asset.institution_or_location') %></dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @asset.institution_or_location || '-' %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.asset.initial_value') %></dt>
        <dd class="mt-1 text-sm text-slate-900"><%= format_currency(@asset.initial_value) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.asset.current_value') %></dt>
        <dd class="mt-1 text-sm text-slate-900 font-bold"><%= format_currency(@asset.current_value) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.asset.valuation_date') %></dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @asset.valuation_date&.strftime('%d/%m/%Y') || '-' %></dd>
      </div>
      <% if @asset.notes.present? %>
        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.asset.notes') %></dt>
          <dd class="mt-1 text-sm text-slate-900"><%= simple_format(@asset.notes) %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>