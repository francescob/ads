<%= form_with(model: asset, url: asset.new_record? ? beneficiary_assets_path(beneficiary) : asset_path(asset), class: 'space-y-6') do |f| %>
  <% if asset.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <ul class="text-sm text-red-700 list-disc pl-5">
        <% asset.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :asset_type, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.select :asset_type, options_for_select([[t('enums.asset.asset_type.bank_account'), 'bank_account'], [t('enums.asset.asset_type.real_estate'), 'real_estate'], [t('enums.asset.asset_type.vehicle'), 'vehicle'], [t('enums.asset.asset_type.securities'), 'securities'], [t('enums.asset.asset_type.cash'), 'cash'], [t('enums.asset.asset_type.other_asset'), 'other_asset']], asset.asset_type), { include_blank: '-- Seleziona --' }, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :description, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :description, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :institution_or_location, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :institution_or_location, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :initial_value, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.number_field :initial_value, step: '0.01', class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :current_value, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.number_field :current_value, step: '0.01', class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :valuation_date, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.date_field :valuation_date, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :notes, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_area :notes, rows: 3, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to t('shared.cancel'), asset.new_record? ? beneficiary_path(beneficiary) : asset_path(asset), class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
    <%= f.submit t('shared.save'), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800 cursor-pointer' %>
  </div>
<% end %>