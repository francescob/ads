<h1>Promemoria Udienza</h1>

<p>Gentile <%= @user.full_name %>,</p>

<p>Le ricordiamo la seguente udienza:</p>

<ul>
  <li><strong>Oggetto:</strong> <%= @hearing.subject %></li>
  <li><strong>Beneficiario:</strong> <%= @beneficiary.full_name %></li>
  <li><strong>Data:</strong> <%= @hearing.hearing_date.strftime('%d/%m/%Y %H:%M') %></li>
  <li><strong>Tribunale:</strong> <%= @hearing.court %></li>
  <% if @hearing.courtroom.present? %>
    <li><strong>Aula:</strong> <%= @hearing.courtroom %></li>
  <% end %>
</ul>

<p>Cordiali saluti,<br>Guardianship App</p>