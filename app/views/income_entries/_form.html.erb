<%= form_with(model: [report, income_entry].compact, url: income_entry.new_record? ? report_income_entries_path(report) : income_entry_path(income_entry), class: 'space-y-3') do |f| %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <div>
      <%= f.label :entry_date, 'Data', class: 'block text-xs font-medium text-slate-600' %>
      <%= f.date_field :entry_date, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm', value: income_entry.entry_date || Date.today %>
    </div>
    <div class="col-span-2 md:col-span-1">
      <%= f.label :description, 'Descrizione', class: 'block text-xs font-medium text-slate-600' %>
      <%= f.text_field :description, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
    </div>
    <div>
      <%= f.label :amount, 'Importo', class: 'block text-xs font-medium text-slate-600' %>
      <%= f.number_field :amount, step: '0.01', min: '0', class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :category, 'Categoria', class: 'block text-xs font-medium text-slate-600' %>
      <%= f.select :category, options_for_select([
        [t('enums.income_entry.category.pension'), 'pension'],
        [t('enums.income_entry.category.allowance'), 'allowance'],
        [t('enums.income_entry.category.annuity'), 'annuity'],
        [t('enums.income_entry.category.other_income'), 'other_income']
      ], income_entry.category), {}, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
    </div>
    <div>
      <%= f.label :source, 'Fonte', class: 'block text-xs font-medium text-slate-600' %>
      <%= f.text_field :source, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
    </div>
  </div>
  <% if income_entry.errors.any? %>
    <div class="text-sm text-red-600">
      <% income_entry.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>
  <div class="flex justify-end">
    <%= f.submit income_entry.new_record? ? 'Aggiungi Entrata' : 'Aggiorna', class: 'inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 cursor-pointer' %>
  </div>
<% end %>