<tr id="<%= dom_id(income_entry) %>">
  <td class="px-4 py-3 text-sm text-slate-500"><%= income_entry.entry_date.strftime('%d/%m/%Y') %></td>
  <td class="px-4 py-3 text-sm text-slate-900">
    <%= income_entry.description %>
    <span class="block text-xs text-slate-400"><%= t("activerecord.enums.income_entry.category.#{income_entry.category}") %></span>
  </td>
  <td class="px-4 py-3 text-sm text-right font-mono text-green-700"><%= format_currency(income_entry.amount) %></td>
  <td class="px-4 py-3 text-right text-sm space-x-2">
    <%= link_to t('shared.edit'), edit_income_entry_path(income_entry), class: 'text-blue-700 hover:text-blue-800' %>
    <%= link_to t('shared.delete'), income_entry_path(income_entry), data: { turbo_method: :delete, turbo_confirm: t('shared.confirm_delete') }, class: 'text-red-600 hover:text-red-800' %>
  </td>
</tr>