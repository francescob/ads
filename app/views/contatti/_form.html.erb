<%= form_with model: [ @beneficiario, contatto ], class: "space-y-6" do |f| %>
  <%= render "shared/errors", record: contatto %>
  <div class="card p-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :nome, "Nome *", class: "form-label" %>
        <%= f.text_field :nome, class: "form-input" %>
      </div>
      <div>
        <%= f.label :tipo, "Tipo", class: "form-label" %>
        <%= f.select :tipo, opzioni(Contatto::TIPI), { include_blank: "—" }, class: "form-input" %>
      </div>
      <div>
        <%= f.label :ruolo, "Ruolo (es. figlia, assistente sociale, MMG)", class: "form-label" %>
        <%= f.text_field :ruolo, class: "form-input" %>
      </div>
      <div>
        <%= f.label :telefono, "Telefono", class: "form-label" %>
        <%= f.telephone_field :telefono, class: "form-input" %>
      </div>
      <div>
        <%= f.label :email, "Email", class: "form-label" %>
        <%= f.email_field :email, class: "form-input" %>
      </div>
      <div>
        <%= f.label :indirizzo, "Indirizzo", class: "form-label" %>
        <%= f.text_field :indirizzo, class: "form-input" %>
      </div>
    </div>
    <div>
      <%= f.label :note, "Note", class: "form-label" %>
      <%= f.text_area :note, rows: 3, class: "form-input" %>
    </div>
  </div>
  <div class="flex justify-end space-x-3">
    <%= link_to "Annulla", @beneficiario, class: "btn-secondary" %>
    <%= f.submit contatto.new_record? ? "Aggiungi Contatto" : "Salva Modifiche", class: "btn-primary" %>
  </div>
<% end %>
