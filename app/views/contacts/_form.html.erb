<%= form_with(model: contact, url: contact.new_record? ? beneficiary_contacts_path(beneficiary) : contact_path(contact), class: 'space-y-6') do |f| %>
  <% if contact.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <ul class="text-sm text-red-700 list-disc pl-5">
        <% contact.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :first_name, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :first_name, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :last_name, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :last_name, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :relationship, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :relationship, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm', placeholder: 'es. figlia, fratello...' %>
      </div>
      <div>
        <%= f.label :phone, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.phone_field :phone, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :email, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.email_field :email, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :notes, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_area :notes, rows: 3, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to t('shared.cancel'), beneficiary_path(beneficiary), class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
    <%= f.submit t('shared.save'), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800 cursor-pointer' %>
  </div>
<% end %>