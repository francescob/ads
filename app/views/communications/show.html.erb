<% content_for(:breadcrumb_extra) { @communication.subject } %>
<div>
  <div class="sm:flex sm:items-center sm:justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900"><%= @communication.subject %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t("activerecord.enums.communication.channel.#{@communication.channel}") %> &mdash; <%= status_badge(@communication.status) %></p>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <%= link_to t('shared.edit'), edit_communication_path(@communication), class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
      <%= link_to t('shared.delete'), communication_path(@communication), data: { turbo_method: :delete, turbo_confirm: t('shared.confirm_delete') }, class: 'inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50' %>
    </div>
  </div>

  <div class="bg-white shadow rounded-lg p-6">
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
      <div>
        <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.communication.counterpart') %></dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @communication.counterpart || '-' %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.communication.sent_at') %></dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @communication.sent_at&.strftime('%d/%m/%Y') || '-' %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.communication.body') %></dt>
        <dd class="mt-1 text-sm text-slate-900"><%= simple_format(@communication.body) %></dd>
      </div>
      <% if @communication.attachment.attached? %>
        <div>
          <dt class="text-sm font-medium text-slate-500">Allegato</dt>
          <dd class="mt-1"><%= link_to 'Download', rails_blob_path(@communication.attachment, disposition: 'attachment'), class: 'text-blue-700 hover:text-blue-800 text-sm font-medium' %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>