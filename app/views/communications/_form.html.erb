<%= form_with(model: communication, url: communication.new_record? ? beneficiary_communications_path(beneficiary) : communication_path(communication), class: 'space-y-6') do |f| %>
  <% if communication.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <ul class="text-sm text-red-700 list-disc pl-5">
        <% communication.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="md:col-span-2">
        <%= f.label :subject, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :subject, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :channel, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.select :channel, options_for_select([[t('enums.communication.channel.pec'), 'pec'], [t('enums.communication.channel.email'), 'email'], [t('enums.communication.channel.registered_mail'), 'registered_mail'], [t('enums.communication.channel.fax'), 'fax']], communication.channel), {}, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :counterpart, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :counterpart, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :status, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.select :status, options_for_select([[t('enums.communication.status.draft'), 'draft'], [t('enums.communication.status.sent'), 'sent'], [t('enums.communication.status.received'), 'received']], communication.status), {}, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :sent_at, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.date_field :sent_at, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :body, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_area :body, rows: 6, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :attachment, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.file_field :attachment, class: 'mt-1 block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100' %>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to t('shared.cancel'), communication.new_record? ? beneficiary_path(beneficiary) : communication_path(communication), class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
    <%= f.submit t('shared.save'), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800 cursor-pointer' %>
  </div>
<% end %>