<% content_for :title, "Modifica Movimento - ADS" %>
<div class="max-w-3xl">
  <nav class="text-sm text-gray-500 mb-6">
    <%= link_to @beneficiario.nome_completo, @beneficiario, class: "hover:underline" %> /
    <%= link_to @conto.nome, beneficiario_conto_path(@beneficiario, @conto), class: "hover:underline" %> / Modifica Movimento
  </nav>
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Modifica Movimento</h1>
  <%= render "form", movimento: @movimento %>
</div>
