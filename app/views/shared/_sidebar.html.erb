<div class="flex flex-col h-full">
  <!-- Logo -->
  <div class="flex items-center h-16 px-6 bg-slate-900">
    <h1 class="text-white text-lg font-bold tracking-tight">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 inline-block mr-2 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
      </svg>
      AdS Manager
    </h1>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    <%= sidebar_link t('navigation.dashboard'), root_path, 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4' %>
    <%= sidebar_link t('navigation.beneficiaries'), beneficiaries_path, 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' %>
    <%= sidebar_link t('navigation.deadlines'), deadlines_path, 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4' %>
    <%= sidebar_link t('navigation.calendar'), calendar_path, 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' %>
  </nav>

  <!-- User info -->
  <div class="flex-shrink-0 px-3 py-4 border-t border-slate-700">
    <div class="flex items-center">
      <div class="flex-shrink-0">
        <div class="h-8 w-8 rounded-full bg-blue-600 flex items-center justify-center">
          <span class="text-white text-sm font-medium"><%= current_user.first_name[0] %><%= current_user.last_name[0] %></span>
        </div>
      </div>
      <div class="ml-3 min-w-0 flex-1">
        <p class="text-sm font-medium text-white truncate"><%= current_user.full_name %></p>
        <p class="text-xs text-slate-400 truncate"><%= current_user.email %></p>
      </div>
    </div>
    <div class="mt-3">
      <%= link_to t('navigation.sign_out'), destroy_user_session_path, data: { turbo_method: :delete }, class: 'text-xs text-slate-400 hover:text-white transition-colors' %>
    </div>
  </div>
</div>