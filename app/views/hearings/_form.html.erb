<%= form_with(model: hearing, url: hearing.new_record? ? beneficiary_hearings_path(beneficiary) : hearing_path(hearing), class: 'space-y-6') do |f| %>
  <% if hearing.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <ul class="text-sm text-red-700 list-disc pl-5">
        <% hearing.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :hearing_date, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.datetime_local_field :hearing_date, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :appointment_id, 'Decreto', class: 'block text-sm font-medium text-slate-700' %>
        <%= f.collection_select :appointment_id, @appointments, :id, ->(a) { "#{a.decree_number} (#{a.appointment_date&.strftime('%d/%m/%Y')})" }, { include_blank: '-- Nessuno --' }, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :court, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :court, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :courtroom, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :courtroom, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :subject, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :subject, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :outcome, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_area :outcome, rows: 3, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :next_hearing_date, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.date_field :next_hearing_date, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :notes, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_area :notes, rows: 3, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to t('shared.cancel'), hearing.new_record? ? beneficiary_path(beneficiary) : hearing_path(hearing), class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
    <%= f.submit t('shared.save'), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800 cursor-pointer' %>
  </div>
<% end %>