<%= form_with(model: document, url: document.new_record? ? beneficiary_documents_path(beneficiary) : document_path(document), class: 'space-y-6') do |f| %>
  <% if document.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <ul class="text-sm text-red-700 list-disc pl-5">
        <% document.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="md:col-span-2">
        <%= f.label :title, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :title, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :document_type, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.select :document_type, options_for_select([[t('enums.document.document_type.identity'), 'identity'], [t('enums.document.document_type.medical_doc'), 'medical_doc'], [t('enums.document.document_type.legal'), 'legal'], [t('enums.document.document_type.financial'), 'financial'], [t('enums.document.document_type.correspondence'), 'correspondence'], [t('enums.document.document_type.other_doc'), 'other_doc']], document.document_type), {}, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :document_date, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.date_field :document_date, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :expiry_date, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.date_field :expiry_date, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
      <div>
        <%= f.label :file, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.file_field :file, class: 'mt-1 block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100' %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :notes, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_area :notes, rows: 3, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm' %>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to t('shared.cancel'), document.new_record? ? beneficiary_path(beneficiary) : document_path(document), class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
    <%= f.submit t('shared.save'), class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800 cursor-pointer' %>
  </div>
<% end %>