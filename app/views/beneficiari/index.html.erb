<% content_for :title, "Beneficiari - ADS" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-bold text-gray-900">Beneficiari</h1>
    <%= link_to "+ Nuovo Beneficiario", new_beneficiario_path, class: "bg-blue-900 text-white px-4 py-2 rounded-lg hover:bg-blue-800 font-medium text-sm" %>
  </div>

  <%= form_with url: beneficiari_path, method: :get, class: "flex gap-2" do |f| %>
    <%= f.search_field :q, value: params[:q], placeholder: "Cerca per nome, cognome o codice fiscale",
          class: "flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    <%= f.submit "Cerca", name: nil, class: "bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-50 text-sm font-medium cursor-pointer" %>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <% if @beneficiari.empty? && params[:q].present? %>
      <p class="px-6 py-12 text-center text-gray-500">Nessun beneficiario corrisponde a "<%= params[:q] %>".</p>
    <% elsif @beneficiari.empty? %>
      <div class="px-6 py-12 text-center">
        <span class="text-5xl">👤</span>
        <p class="mt-4 text-gray-500">Nessun beneficiario registrato.</p>
        <%= link_to "Aggiungi il primo beneficiario", new_beneficiario_path, class: "mt-2 text-blue-600 hover:underline text-sm" %>
      </div>
    <% else %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nome</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Codice Fiscale</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Telefono</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Procedimenti</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Azioni</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @beneficiari.each do |b| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <p class="font-medium text-gray-900"><%= b.nome_completo %></p>
                <% if b.data_nascita %><p class="text-xs text-gray-500">Nato il <%= data_it(b.data_nascita) %></p><% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-600"><%= b.codice_fiscale.presence || "—" %></td>
              <td class="px-6 py-4 text-sm text-gray-600"><%= b.telefono.presence || "—" %></td>
              <td class="px-6 py-4 text-sm text-gray-600"><%= b.email.presence || "—" %></td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                  <%= b.procedimenti.count %>
                </span>
              </td>
              <td class="px-6 py-4 text-right space-x-2">
                <%= link_to "Vedi", b, class: "text-blue-600 hover:underline text-sm" %>
                <%= link_to "Modifica", edit_beneficiario_path(b), class: "text-yellow-600 hover:underline text-sm" %>
                <%= button_to "Elimina", b, method: :delete, data: { turbo_confirm: "Sei sicuro di voler eliminare #{b.nome_completo}?" }, class: "text-red-600 hover:underline text-sm bg-transparent border-none cursor-pointer" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
