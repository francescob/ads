<% content_for :title, "#{@beneficiario.nome_completo} - ADS" %>

<div class="space-y-6">
  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500">
    <%= link_to "Beneficiari", beneficiari_path, class: "hover:underline" %> /
    <span class="text-gray-900"><%= @beneficiario.nome_completo %></span>
  </nav>

  <!-- Header -->
  <div class="flex items-start justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @beneficiario.nome_completo %></h1>
      <% if @beneficiario.codice_fiscale.present? %>
        <p class="text-gray-500 mt-1">CF: <%= @beneficiario.codice_fiscale %></p>
      <% end %>
    </div>
    <div class="flex space-x-3">
      <%= link_to "Modifica", edit_beneficiario_path(@beneficiario), class: "bg-yellow-500 text-white px-4 py-2 rounded-lg hover:bg-yellow-400 text-sm font-medium" %>
      <%= link_to "+ Nuovo Procedimento", new_beneficiario_procedimento_path(@beneficiario), class: "bg-blue-900 text-white px-4 py-2 rounded-lg hover:bg-blue-800 text-sm font-medium" %>
    </div>
  </div>

  <!-- Personal info -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Informazioni Personali</h2>
    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% if @beneficiario.data_nascita %>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase">Data di Nascita</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @beneficiario.data_nascita.strftime("%d/%m/%Y") %></dd>
        </div>
      <% end %>
      <% if @beneficiario.luogo_nascita.present? %>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase">Luogo di Nascita</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @beneficiario.luogo_nascita %></dd>
        </div>
      <% end %>
      <% if @beneficiario.indirizzo.present? %>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase">Indirizzo</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @beneficiario.indirizzo %></dd>
        </div>
      <% end %>
      <% if @beneficiario.telefono.present? %>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase">Telefono</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @beneficiario.telefono %></dd>
        </div>
      <% end %>
      <% if @beneficiario.email.present? %>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase">Email</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @beneficiario.email %></dd>
        </div>
      <% end %>
    </dl>
    <% if @beneficiario.note.present? %>
      <div class="mt-4 pt-4 border-t border-gray-100">
        <dt class="text-xs font-medium text-gray-500 uppercase mb-1">Note</dt>
        <dd class="text-sm text-gray-700"><%= simple_format(@beneficiario.note) %></dd>
      </div>
    <% end %>
  </div>

  <!-- Procedimenti -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center">
      <h2 class="text-lg font-semibold text-gray-900">Procedimenti</h2>
      <%= link_to "+ Nuovo", new_beneficiario_procedimento_path(@beneficiario), class: "text-blue-600 text-sm hover:underline" %>
    </div>
    <% if @procedimenti.empty? %>
      <p class="px-6 py-4 text-gray-500 text-sm">Nessun procedimento.</p>
    <% else %>
      <div class="divide-y divide-gray-100">
        <% @procedimenti.each do |p| %>
          <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50">
            <div>
              <p class="font-medium text-gray-900 text-sm">
                <%= p.numero_rg.present? ? "RG #{p.numero_rg}" : "Procedimento ##{p.id}" %>
                <% if p.tribunale.present? %> - <%= p.tribunale %><% end %>
              </p>
              <p class="text-xs text-gray-500 mt-0.5">
                Aperto il <%= p.data_apertura&.strftime("%d/%m/%Y") || "—" %>
              </p>
            </div>
            <div class="flex items-center space-x-3">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                <%= p.stato == 'attivo' ? 'bg-green-100 text-green-800' : p.stato == 'chiuso' ? 'bg-gray-100 text-gray-800' : 'bg-yellow-100 text-yellow-800' %>">
                <%= p.stato&.capitalize || "—" %>
              </span>
              <%= link_to "Dettaglio →", beneficiario_procedimento_path(@beneficiario, p), class: "text-blue-600 hover:underline text-sm" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
