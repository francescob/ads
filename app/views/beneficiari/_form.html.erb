<%= form_with model: beneficiario, class: "space-y-6" do |f| %>
  <%= render "shared/errors", record: beneficiario %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-4">
    <h3 class="text-base font-semibold text-gray-900 pb-2 border-b border-gray-100">Dati Anagrafici</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :nome, "Nome *", class: "form-label" %>
        <%= f.text_field :nome, class: "form-input" %>
      </div>
      <div>
        <%= f.label :cognome, "Cognome *", class: "form-label" %>
        <%= f.text_field :cognome, class: "form-input" %>
      </div>
      <div>
        <%= f.label :codice_fiscale, "Codice Fiscale", class: "form-label" %>
        <%= f.text_field :codice_fiscale, class: "form-input" %>
      </div>
      <div>
        <%= f.label :data_nascita, "Data di Nascita", class: "form-label" %>
        <%= f.date_field :data_nascita, class: "form-input" %>
      </div>
      <div>
        <%= f.label :luogo_nascita, "Luogo di Nascita", class: "form-label" %>
        <%= f.text_field :luogo_nascita, class: "form-input" %>
      </div>
      <div>
        <%= f.label :indirizzo, "Indirizzo", class: "form-label" %>
        <%= f.text_field :indirizzo, class: "form-input" %>
      </div>
      <div>
        <%= f.label :telefono, "Telefono", class: "form-label" %>
        <%= f.telephone_field :telefono, class: "form-input" %>
      </div>
      <div>
        <%= f.label :email, "Email", class: "form-label" %>
        <%= f.email_field :email, class: "form-input" %>
      </div>
    </div>
    <div>
      <%= f.label :note, "Note", class: "form-label" %>
      <%= f.text_area :note, rows: 3, class: "form-input" %>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Annulla", beneficiari_path, class: "btn-secondary" %>
    <%= f.submit beneficiario.new_record? ? "Crea Beneficiario" : "Salva Modifiche", class: "btn-primary" %>
  </div>
<% end %>
