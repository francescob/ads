<%= form_with model: beneficiario, class: "space-y-6" do |f| %>
  <% if beneficiario.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <p class="font-medium text-red-800 mb-2"><%= beneficiario.errors.count %> errori impediscono il salvataggio:</p>
      <ul class="list-disc list-inside text-sm text-red-700">
        <% beneficiario.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-4">
    <h3 class="text-base font-semibold text-gray-900 pb-2 border-b border-gray-100">Dati Anagrafici</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :nome, "Nome *", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :nome, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label :cognome, "Cognome *", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :cognome, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label :codice_fiscale, "Codice Fiscale", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :codice_fiscale, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label :data_nascita, "Data di Nascita", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :data_nascita, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label :luogo_nascita, "Luogo di Nascita", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :luogo_nascita, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label :indirizzo, "Indirizzo", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :indirizzo, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label :telefono, "Telefono", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.telephone_field :telefono, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>
    <div>
      <%= f.label :note, "Note", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :note, rows: 3, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Annulla", beneficiari_path, class: "bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-50 text-sm font-medium" %>
    <%= f.submit beneficiario.new_record? ? "Crea Beneficiario" : "Salva Modifiche", class: "bg-blue-900 text-white px-6 py-2 rounded-lg hover:bg-blue-800 text-sm font-medium cursor-pointer" %>
  </div>
<% end %>
