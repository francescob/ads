<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <div class="flex items-center text-sm text-slate-500 mb-2">
      <%= link_to t('dashboard.title'), root_path, class: "hover:text-slate-700" %>
      <span class="mx-2">/</span>
      <%= link_to t('beneficiaries.title'), beneficiaries_path, class: "hover:text-slate-700" %>
      <span class="mx-2">/</span>
      <%= link_to @beneficiary.full_name, @beneficiary, class: "hover:text-slate-700" %>
      <span class="mx-2">/</span>
      <span class="text-slate-900"><%= t('liabilities.new') %></span>
    </div>
    <h1 class="text-3xl font-bold text-slate-900"><%= t('liabilities.new') %></h1>
    <p class="mt-2 text-sm text-slate-600"><%= t('liabilities.new_description') %></p>
  </div>

  <%= render 'form', liability: @liability, beneficiary: @beneficiary %>
</div>
