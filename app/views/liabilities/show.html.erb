<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <div class="flex items-center text-sm text-slate-500 mb-2">
      <%= link_to t('dashboard.title'), root_path, class: "hover:text-slate-700" %>
      <span class="mx-2">/</span>
      <%= link_to t('beneficiaries.title'), beneficiaries_path, class: "hover:text-slate-700" %>
      <span class="mx-2">/</span>
      <%= link_to @beneficiary.full_name, @beneficiary, class: "hover:text-slate-700" %>
      <span class="mx-2">/</span>
      <%= link_to t('liabilities.title'), beneficiary_liabilities_path(@beneficiary), class: "hover:text-slate-700" %>
      <span class="mx-2">/</span>
      <span class="text-slate-900"><%= @liability.description %></span>
    </div>
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-slate-900"><%= @liability.description %></h1>
        <p class="mt-2 text-sm text-slate-600">
          <%= t("activerecord.enums.liability.liability_type.#{@liability.liability_type}") %> &mdash; <%= @liability.creditor %>
        </p>
      </div>
      <div class="flex space-x-3">
        <%= link_to t('shared.edit'), edit_liability_path(@liability), class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
        <%= link_to t('shared.delete'), liability_path(@liability), data: { turbo_method: :delete, turbo_confirm: t('shared.confirm_delete') }, class: 'inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50' %>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <!-- Importi e Stato -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200">
        <h2 class="text-lg font-medium text-slate-900"><%= t('liabilities.financial_details') %></h2>
      </div>
      <div class="px-6 py-5">
        <dl class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2">
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.liability.initial_amount') %></dt>
            <dd class="mt-1 text-2xl font-semibold <%= @liability.initial_amount.nil? ? 'text-slate-400' : 'text-slate-900' %>">
              <%= format_currency(@liability.initial_amount) %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.liability.remaining_balance') %></dt>
            <dd class="mt-1 text-2xl font-semibold <%= @liability.remaining_balance.nil? ? 'text-slate-400' : (@liability.paid_off? ? 'text-green-600' : 'text-red-600') %>">
              <%= format_currency(@liability.remaining_balance) %>
            </dd>
          </div>
        </dl>

        <!-- Progress Bar -->
        <% if @liability.percentage_paid.present? %>
          <div class="mt-6">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium text-slate-700"><%= t('liabilities.payment_progress') %></span>
              <span class="text-sm font-medium text-slate-900"><%= format_percentage(@liability.percentage_paid) %></span>
            </div>
            <div class="w-full bg-slate-200 rounded-full h-3">
              <div class="bg-green-600 h-3 rounded-full transition-all duration-300" style="width: <%= @liability.percentage_paid %>%"></div>
            </div>
            <div class="flex items-center justify-between mt-1">
              <span class="text-xs text-slate-500"><%= t('liabilities.paid') %>: <%= format_currency(@liability.initial_amount - @liability.remaining_balance) %></span>
              <span class="text-xs text-slate-500"><%= t('liabilities.remaining') %>: <%= format_currency(@liability.remaining_balance) %></span>
            </div>
          </div>
        <% end %>

        <dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 mt-6">
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.liability.interest_rate') %></dt>
            <dd class="mt-1 text-lg font-medium <%= @liability.interest_rate.present? ? 'text-slate-900' : 'text-slate-400' %>">
              <%= @liability.interest_rate.present? ? number_to_percentage(@liability.interest_rate, precision: 2) : '-' %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.liability.monthly_payment') %></dt>
            <dd class="mt-1 text-lg font-medium <%= @liability.monthly_payment.present? ? 'text-slate-900' : 'text-slate-400' %>">
              <%= format_currency(@liability.monthly_payment) %>
            </dd>
          </div>
        </dl>

        <% if @liability.estimated_months_remaining.present? && @liability.estimated_months_remaining > 0 %>
          <div class="mt-6 bg-blue-50 border border-blue-200 rounded-md p-4">
            <p class="text-sm text-blue-800">
              <span class="font-medium"><%= t('liabilities.estimated_months_remaining') %>:</span>
              <%= @liability.estimated_months_remaining %> <%= t('liabilities.months') %>
              <% if @liability.end_date.present? %>
                (circa <%= l(@liability.end_date, format: :long) %>)
              <% end %>
            </p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Date e Informazioni -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200">
        <h2 class="text-lg font-medium text-slate-900"><%= t('liabilities.general_info') %></h2>
      </div>
      <div class="px-6 py-5">
        <dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.liability.liability_type') %></dt>
            <dd class="mt-1 text-sm text-slate-900">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                <%= t("activerecord.enums.liability.liability_type.#{@liability.liability_type}") %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.liability.creditor') %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @liability.creditor %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.liability.start_date') %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @liability.start_date ? l(@liability.start_date, format: :long) : '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.liability.end_date') %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @liability.end_date ? l(@liability.end_date, format: :long) : '-' %></dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Note -->
    <% if @liability.notes.present? %>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200">
          <h2 class="text-lg font-medium text-slate-900"><%= t('activerecord.attributes.liability.notes') %></h2>
        </div>
        <div class="px-6 py-5">
          <p class="text-sm text-slate-700 whitespace-pre-wrap"><%= @liability.notes %></p>
        </div>
      </div>
    <% end %>

    <!-- Timestamps -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4">
        <dl class="grid grid-cols-1 gap-x-6 gap-y-2 sm:grid-cols-2 text-xs text-slate-500">
          <div>
            <dt class="inline"><%= t('shared.created_at') %>:</dt>
            <dd class="inline ml-1"><%= l(@liability.created_at, format: :long) %></dd>
          </div>
          <div>
            <dt class="inline"><%= t('shared.updated_at') %>:</dt>
            <dd class="inline ml-1"><%= l(@liability.updated_at, format: :long) %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <div class="mt-6">
    <%= link_to t('shared.back'), beneficiary_path(@beneficiary), class: 'text-blue-700 hover:text-blue-800 font-medium' %>
  </div>
</div>
