<%= native_navbar_tag("Home") %>

<div>
  <h1 class="text-2xl font-bold text-slate-900 mb-6"><%= t('dashboard.title') %></h1>

  <!-- KPI Cards -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-8">
    <!-- Active Beneficiaries -->
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-10 w-10 rounded-md bg-blue-700 flex items-center justify-center">
              <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
          </div>
          <div class="ml-5">
            <p class="text-sm font-medium text-slate-500 truncate"><%= t('dashboard.active_beneficiaries') %></p>
            <p class="text-2xl font-semibold text-slate-900"><%= @active_count %></p>
          </div>
        </div>
      </div>
      <div class="bg-slate-50 px-5 py-3">
        <%= link_to t('dashboard.view_all'), beneficiaries_path, class: 'text-sm font-medium text-blue-700 hover:text-blue-800' %>
      </div>
    </div>

    <!-- Upcoming 7 days -->
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-10 w-10 rounded-md bg-orange-500 flex items-center justify-center">
              <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
          </div>
          <div class="ml-5">
            <p class="text-sm font-medium text-slate-500 truncate"><%= t('dashboard.upcoming_deadlines_7') %></p>
            <p class="text-2xl font-semibold text-slate-900"><%= @upcoming_7_count %></p>
          </div>
        </div>
      </div>
      <div class="bg-slate-50 px-5 py-3">
        <%= link_to t('dashboard.view_deadlines'), deadlines_path, class: 'text-sm font-medium text-blue-700 hover:text-blue-800' %>
      </div>
    </div>

    <!-- Upcoming 30 days -->
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-10 w-10 rounded-md bg-yellow-500 flex items-center justify-center">
              <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          </div>
          <div class="ml-5">
            <p class="text-sm font-medium text-slate-500 truncate"><%= t('dashboard.upcoming_deadlines_30') %></p>
            <p class="text-2xl font-semibold text-slate-900"><%= @upcoming_30_count %></p>
          </div>
        </div>
      </div>
      <div class="bg-slate-50 px-5 py-3">
        <%= link_to t('dashboard.view_calendar'), calendar_path, class: 'text-sm font-medium text-blue-700 hover:text-blue-800' %>
      </div>
    </div>

    <!-- Draft Reports -->
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="h-10 w-10 rounded-md bg-slate-600 flex items-center justify-center">
              <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
          </div>
          <div class="ml-5">
            <p class="text-sm font-medium text-slate-500 truncate"><%= t('dashboard.draft_reports') %></p>
            <p class="text-2xl font-semibold text-slate-900"><%= @draft_reports_count %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Overdue Deadlines -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-6 py-4 border-b border-slate-200">
        <h2 class="text-lg font-semibold text-slate-900"><%= t('dashboard.overdue_deadlines') %></h2>
      </div>
      <div class="p-6">
        <% if @overdue_deadlines.any? %>
          <ul class="divide-y divide-slate-200">
            <% @overdue_deadlines.each do |deadline| %>
              <li class="py-3 flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-red-600"><%= deadline.title %></p>
                  <p class="text-xs text-slate-500"><%= deadline.beneficiary.full_name %> &mdash; <%= deadline.due_date.strftime('%d/%m/%Y') %></p>
                </div>
                <%= priority_badge(deadline.priority) %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-slate-500 text-center py-4"><%= t('dashboard.no_overdue') %></p>
        <% end %>
      </div>
    </div>

    <!-- Upcoming Deadlines -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-slate-900"><%= t('dashboard.recent_deadlines') %></h2>
        <%= link_to t('dashboard.view_all'), deadlines_path, class: 'text-sm text-blue-700 hover:text-blue-800' %>
      </div>
      <div class="p-6">
        <% if @upcoming_deadlines.any? %>
          <ul class="divide-y divide-slate-200">
            <% @upcoming_deadlines.each do |deadline| %>
              <li class="py-3 flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-slate-900"><%= deadline.title %></p>
                  <p class="text-xs text-slate-500"><%= deadline.beneficiary.full_name %> &mdash; <%= deadline.due_date.strftime('%d/%m/%Y') %></p>
                </div>
                <%= priority_badge(deadline.priority) %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-slate-500 text-center py-4"><%= t('dashboard.no_deadlines') %></p>
        <% end %>
      </div>
    </div>

    <!-- Draft Reports -->
    <div class="bg-white shadow rounded-lg lg:col-span-2">
      <div class="px-6 py-4 border-b border-slate-200">
        <h2 class="text-lg font-semibold text-slate-900"><%= t('dashboard.draft_reports') %></h2>
      </div>
      <div class="p-6">
        <% if @draft_reports.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
              <thead>
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Beneficiario</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Anno</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Periodo</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase">Stato</th>
                  <th class="px-4 py-3"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% @draft_reports.each do |report| %>
                  <tr class="hover:bg-slate-50">
                    <td class="px-4 py-3 text-sm text-slate-900"><%= report.beneficiary.full_name %></td>
                    <td class="px-4 py-3 text-sm text-slate-500"><%= report.reference_year %></td>
                    <td class="px-4 py-3 text-sm text-slate-500"><%= report.period_from.strftime('%d/%m/%Y') %> - <%= report.period_to.strftime('%d/%m/%Y') %></td>
                    <td class="px-4 py-3"><%= status_badge(report.status) %></td>
                    <td class="px-4 py-3 text-right">
                      <%= link_to 'Apri', report_path(report), class: 'text-sm text-blue-700 hover:text-blue-800 font-medium' %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-sm text-slate-500 text-center py-4"><%= t('dashboard.no_draft_reports') %></p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="mt-8">
    <h2 class="text-lg font-semibold text-slate-900 mb-4"><%= t('dashboard.quick_actions') %></h2>
    <div class="flex flex-wrap gap-3">
      <%= link_to t('dashboard.new_beneficiary'), new_beneficiary_path, class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500', data: native_haptic_data(:success) %>
      <%= link_to t('dashboard.view_calendar'), calendar_path, class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500', data: native_haptic_data(:impact) %>
      <%= link_to t('dashboard.view_deadlines'), deadlines_path, class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500', data: native_haptic_data(:impact) %>
    </div>
  </div>
</div>