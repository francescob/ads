<%= form_with model: user, class: "space-y-6" do |f| %>
  <%= render "shared/errors", record: user %>
  <div class="card p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :nome, "Nome *", class: "form-label" %>
      <%= f.text_field :nome, class: "form-input" %>
    </div>
    <div>
      <%= f.label :email_address, "Email *", class: "form-label" %>
      <%= f.email_field :email_address, class: "form-input" %>
    </div>
    <div>
      <%= f.label :ruolo, "Ruolo", class: "form-label" %>
      <%= f.select :ruolo, User::RUOLI.map { |r| [ r.capitalize, r ] }, {}, class: "form-input" %>
    </div>
    <div class="flex items-center space-x-2 pt-6">
      <%= f.check_box :attivo, class: "h-4 w-4" %>
      <%= f.label :attivo, "Attivo", class: "text-sm font-medium text-gray-700" %>
    </div>
    <div>
      <%= f.label :password, user.new_record? ? "Password * (min. 10 caratteri)" : "Nuova password (lascia vuoto per non cambiarla)", class: "form-label" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "form-input" %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Conferma password", class: "form-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
    </div>
  </div>
  <div class="flex justify-end space-x-3">
    <%= link_to "Annulla", users_path, class: "btn-secondary" %>
    <%= f.submit user.new_record? ? "Crea Utente" : "Salva Modifiche", class: "btn-primary" %>
  </div>
<% end %>
