<div class="mb-6">
  <nav class="text-sm text-slate-600">
    <%= link_to "Dashboard", root_path, class: "hover:text-blue-700" %>
    <span class="mx-2">/</span>
    <%= link_to "Beneficiari", beneficiaries_path, class: "hover:text-blue-700" %>
    <% if @beneficiary&.persisted? %>
      <span class="mx-2">/</span>
      <%= link_to @beneficiary.full_name, beneficiary_path(@beneficiary), class: "hover:text-blue-700" %>
    <% end %>
    <span class="mx-2">/</span>
    <span class="text-slate-900 font-medium">Immobili</span>
  </nav>
</div>

<div class="mb-6 flex justify-between items-start">
  <div>
    <h1 class="text-3xl font-bold text-slate-900">Immobili</h1>
    <p class="mt-2 text-slate-600">Gestione degli immobili di <%= @beneficiary.full_name %></p>
  </div>
  <%= link_to "Nuovo Immobile", new_beneficiary_property_path(@beneficiary), class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800" %>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
    <p class="text-sm font-medium text-blue-900">Numero Immobili</p>
    <p class="text-2xl font-bold text-blue-700"><%= @properties.count %></p>
  </div>
  <div class="bg-green-50 border border-green-200 rounded-lg p-4">
    <p class="text-sm font-medium text-green-900">Valore Totale</p>
    <p class="text-2xl font-bold text-green-700"><%= number_to_currency(@beneficiary.total_properties_value, unit: "€ ", separator: ",", delimiter: ".", precision: 0) %></p>
  </div>
  <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
    <p class="text-sm font-medium text-purple-900">Valore Quote di Proprietà</p>
    <p class="text-2xl font-bold text-purple-700"><%= number_to_currency(@beneficiary.total_owned_properties_value, unit: "€ ", separator: ",", delimiter: ".", precision: 0) %></p>
  </div>
</div>

<% if @properties.any? %>
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Tipo</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Descrizione</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Indirizzo</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Dati Catastali</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Rendita Cat.</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-slate-500 uppercase tracking-wider">Quota %</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Valore Attuale</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider"></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-slate-200">
        <% @properties.each do |property| %>
          <tr class="hover:bg-slate-50">
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                <%= property.property_type.humanize %>
              </span>
            </td>
            <td class="px-6 py-4">
              <%= link_to property.description, property_path(property), class: 'text-sm font-medium text-blue-700 hover:text-blue-800' %>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-slate-900"><%= property.address.presence || "-" %></div>
              <% if property.city.present? %>
                <div class="text-xs text-slate-500"><%= property.zip_code %> <%= property.city %> (<%= property.province %>)</div>
              <% end %>
            </td>
            <td class="px-6 py-4">
              <% if property.cadastral_reference.present? %>
                <div class="text-xs text-slate-900"><%= property.cadastral_reference %></div>
              <% end %>
              <% if property.cadastral_classification.present? %>
                <div class="text-xs text-slate-500"><%= property.cadastral_classification %></div>
              <% end %>
              <% if property.cadastral_reference.blank? && property.cadastral_classification.blank? %>
                <span class="text-sm text-slate-400">-</span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm text-slate-900">
              <% if property.cadastral_income.present? %>
                <%= number_to_currency(property.cadastral_income, unit: "€ ", separator: ",", delimiter: ".", precision: 2) %>
              <% else %>
                <span class="text-slate-400">-</span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-center text-sm text-slate-900">
              <% if property.ownership_fraction.present? %>
                <span class="font-medium"><%= property.ownership_fraction %></span>
              <% else %>
                <span class="text-slate-400">-</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium font-mono text-slate-900">
              <% if property.current_value.present? %>
                <%= number_to_currency(property.current_value, unit: "€ ", separator: ",", delimiter: ".", precision: 2) %>
              <% else %>
                <span class="text-slate-400">-</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "Visualizza", property_path(property), class: "text-blue-700 hover:text-blue-800 mr-3" %>
              <%= link_to "Modifica", edit_property_path(property), class: "text-blue-700 hover:text-blue-800" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-slate-50">
        <tr>
          <td colspan="6" class="px-6 py-4 text-right text-sm font-bold text-slate-700">
            TOTALE VALORE IMMOBILI:
          </td>
          <td class="px-6 py-4 text-right text-sm font-bold font-mono text-slate-900">
            <%= number_to_currency(@beneficiary.total_properties_value, unit: "€ ", separator: ",", delimiter: ".", precision: 2) %>
          </td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
<% else %>
  <div class="bg-white shadow rounded-lg p-12 text-center">
    <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
    </svg>
    <h3 class="mt-2 text-sm font-medium text-slate-900">Nessun immobile</h3>
    <p class="mt-1 text-sm text-slate-500">Inizia aggiungendo un immobile al patrimonio del beneficiario.</p>
    <div class="mt-6">
      <%= link_to "Nuovo Immobile", new_beneficiary_property_path(@beneficiary), class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-700 hover:bg-blue-800" %>
    </div>
  </div>
<% end %>

<div class="mt-6">
  <%= link_to "← Torna al Beneficiario", beneficiary_path(@beneficiary), class: "text-sm text-blue-700 hover:text-blue-800" %>
</div>