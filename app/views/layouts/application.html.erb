<!DOCTYPE html>
<html lang="it">
  <head>
    <title><%= content_for(:title) || "ADS - Amministrazione di Sostegno" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <!-- Navbar -->
    <nav class="bg-blue-900 text-white shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <a href="<%= root_path %>" class="flex items-center space-x-2">
              <span class="text-2xl font-bold text-white">⚖️</span>
              <span class="text-xl font-semibold">ADS</span>
              <span class="hidden md:block text-sm text-blue-200">Amministrazione di Sostegno</span>
            </a>
          </div>
          <div class="flex items-center space-x-4">
            <%= link_to "Dashboard", root_path, class: "text-blue-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
            <%= link_to "Beneficiari", beneficiari_path, class: "text-blue-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
            <%= link_to "Scadenze", scadenze_path, class: "text-blue-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
            <%= link_to "Udienze", udienze_path, class: "text-blue-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
          </div>
        </div>
      </div>
    </nav>

    <!-- Flash messages -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
      <% if notice %>
        <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-4" role="alert">
          <%= notice %>
        </div>
      <% end %>
      <% if alert %>
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg mb-4" role="alert">
          <%= alert %>
        </div>
      <% end %>
    </div>

    <!-- Main content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-blue-900 text-blue-200 mt-12 py-6">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm">
        <p>ADS - Amministrazione di Sostegno &copy; <%= Date.current.year %></p>
      </div>
    </footer>
  </body>
</html>
