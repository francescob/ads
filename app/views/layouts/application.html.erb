<!DOCTYPE html>
<html lang="it">
  <head>
    <title><%= content_for(:title) || "ADS - Amministrazione di Sostegno" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <!-- Navbar -->
    <nav class="no-print bg-blue-900 text-white shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <a href="<%= root_path %>" class="flex items-center space-x-2">
              <span class="text-2xl font-bold text-white">⚖️</span>
              <span class="text-xl font-semibold">ADS</span>
              <span class="hidden md:block text-sm text-blue-200">Amministrazione di Sostegno</span>
            </a>
          </div>
          <div class="flex items-center space-x-4">
            <%= link_to "Dashboard", root_path, class: "text-blue-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
            <%= link_to "Beneficiari", beneficiari_path, class: "text-blue-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
            <%= link_to "Scadenze", scadenze_path, class: "text-blue-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
            <%= link_to "Udienze", udienze_path, class: "text-blue-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
            <% if Current.user&.admin? %>
              <%= link_to "Utenti", users_path, class: "text-blue-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
              <%= link_to "Registro", modifiche_path, class: "text-blue-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
            <% end %>
            <% if Current.user %>
              <%= form_with url: ricerca_path, method: :get, class: "hidden lg:block" do |f| %>
                <%= f.search_field :q, placeholder: "Cerca…", class: "rounded-md bg-blue-800 text-white placeholder-blue-300 text-sm px-3 py-1.5 w-40 focus:w-56 transition-all border-none" %>
              <% end %>
              <span class="border-l border-blue-700 h-6"></span>
              <%= link_to Current.user.nome, edit_password_path, title: "Profilo", class: "text-blue-200 hover:text-white text-sm" %>
              <%= button_to "Esci", session_path, method: :delete, class: "text-blue-100 hover:text-white text-sm bg-transparent border-none cursor-pointer" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <!-- Flash messages -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
      <%= render "shared/flash" %>
    </div>

    <!-- Main content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="no-print bg-blue-900 text-blue-200 mt-12 py-6">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm">
        <p>ADS - Amministrazione di Sostegno &copy; <%= Date.current.year %></p>
      </div>
    </footer>
  </body>
</html>
