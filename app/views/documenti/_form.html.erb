<%= form_with model: [ @beneficiario, @procedimento, documento ], class: "space-y-6" do |f| %>
  <%= render "shared/errors", record: documento %>
  <div class="card p-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="sm:col-span-2">
        <%= f.label :titolo, "Titolo *", class: "form-label" %>
        <%= f.text_field :titolo, class: "form-input" %>
      </div>
      <div>
        <%= f.label :categoria, "Categoria", class: "form-label" %>
        <%= f.select :categoria, opzioni(Documento::CATEGORIE), { include_blank: "—" }, class: "form-input" %>
      </div>
      <div>
        <%= f.label :data_documento, "Data documento", class: "form-label" %>
        <%= f.date_field :data_documento, class: "form-input" %>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :file, documento.file.attached? ? "Sostituisci file (attuale: #{documento.file.filename})" : "File *", class: "form-label" %>
        <%= f.file_field :file, class: "form-input" %>
      </div>
    </div>
    <div>
      <%= f.label :note, "Note", class: "form-label" %>
      <%= f.text_area :note, rows: 3, class: "form-input" %>
    </div>
  </div>
  <div class="flex justify-end space-x-3">
    <%= link_to "Annulla", beneficiario_procedimento_path(@beneficiario, @procedimento), class: "btn-secondary" %>
    <%= f.submit documento.new_record? ? "Carica Documento" : "Salva Modifiche", class: "btn-primary" %>
  </div>
<% end %>
