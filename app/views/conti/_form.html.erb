<%= form_with model: [ @beneficiario, conto ], class: "space-y-6" do |f| %>
  <%= render "shared/errors", record: conto %>
  <div class="card p-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :nome, "Nome *", class: "form-label" %>
        <%= f.text_field :nome, placeholder: "es. Conto corrente pensione", class: "form-input" %>
      </div>
      <div>
        <%= f.label :tipo, "Tipo", class: "form-label" %>
        <%= f.select :tipo, opzioni(Conto::TIPI), { include_blank: "—" }, class: "form-input" %>
      </div>
      <div>
        <%= f.label :istituto, "Banca / istituto", class: "form-label" %>
        <%= f.text_field :istituto, class: "form-input" %>
      </div>
      <div>
        <%= f.label :iban, "IBAN", class: "form-label" %>
        <%= f.text_field :iban, class: "form-input" %>
      </div>
      <div>
        <%= f.label :saldo_iniziale, "Saldo iniziale (€)", class: "form-label" %>
        <%= f.number_field :saldo_iniziale, step: 0.01, class: "form-input" %>
      </div>
      <div>
        <%= f.label :data_saldo_iniziale, "Data saldo iniziale", class: "form-label" %>
        <%= f.date_field :data_saldo_iniziale, class: "form-input" %>
      </div>
      <div class="flex items-center space-x-2">
        <%= f.check_box :attivo, class: "h-4 w-4" %>
        <%= f.label :attivo, "Conto attivo", class: "text-sm font-medium text-gray-700" %>
      </div>
    </div>
    <div>
      <%= f.label :note, "Note", class: "form-label" %>
      <%= f.text_area :note, rows: 2, class: "form-input" %>
    </div>
  </div>
  <div class="flex justify-end space-x-3">
    <%= link_to "Annulla", conto.persisted? ? [ @beneficiario, conto ] : @beneficiario, class: "btn-secondary" %>
    <%= f.submit conto.new_record? ? "Crea Conto" : "Salva Modifiche", class: "btn-primary" %>
  </div>
<% end %>
