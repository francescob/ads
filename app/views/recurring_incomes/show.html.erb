<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <div class="flex items-center text-sm text-slate-500 mb-2">
      <%= link_to t('dashboard.title'), root_path, class: "hover:text-slate-700" %>
      <span class="mx-2">/</span>
      <%= link_to t('beneficiaries.title'), beneficiaries_path, class: "hover:text-slate-700" %>
      <span class="mx-2">/</span>
      <%= link_to @beneficiary.full_name, @beneficiary, class: "hover:text-slate-700" %>
      <span class="mx-2">/</span>
      <%= link_to t('recurring_incomes.title'), beneficiary_recurring_incomes_path(@beneficiary), class: "hover:text-slate-700" %>
      <span class="mx-2">/</span>
      <span class="text-slate-900"><%= @recurring_income.description %></span>
    </div>
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-slate-900"><%= @recurring_income.description %></h1>
        <p class="mt-2 text-sm text-slate-600">
          <%= t("activerecord.enums.recurring_income.income_type.#{@recurring_income.income_type}") %> &mdash; 
          <%= t("activerecord.enums.recurring_income.frequency.#{@recurring_income.frequency}") %>
        </p>
      </div>
      <div class="flex space-x-3">
        <%= link_to t('shared.edit'), edit_recurring_income_path(@recurring_income), class: 'inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50' %>
        <%= link_to t('recurring_incomes.toggle_status'), toggle_active_recurring_income_path(@recurring_income), data: { turbo_method: :patch }, class: "inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md #{@recurring_income.active? ? 'text-orange-700 border-orange-300 hover:bg-orange-50' : 'text-green-700 border-green-300 hover:bg-green-50'} bg-white" %>
        <%= link_to t('shared.delete'), recurring_income_path(@recurring_income), data: { turbo_method: :delete, turbo_confirm: t('shared.confirm_delete') }, class: 'inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50' %>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <!-- Stato e Importi -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200">
        <h2 class="text-lg font-medium text-slate-900"><%= t('recurring_incomes.financial_info') %></h2>
      </div>
      <div class="px-6 py-5">
        <div class="flex items-center justify-between mb-6">
          <div>
            <span class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.recurring_income.active') %></span>
          </div>
          <div>
            <% if @recurring_income.currently_active? %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                <svg class="mr-1.5 h-2 w-2 fill-current" viewBox="0 0 8 8">
                  <circle cx="4" cy="4" r="3" />
                </svg>
                <%= t('recurring_incomes.status.active') %>
              </span>
            <% elsif @recurring_income.active? %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                <%= t('recurring_incomes.status.scheduled') %>
              </span>
            <% else %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-slate-100 text-slate-800">
                <%= t('recurring_incomes.status.inactive') %>
              </span>
            <% end %>
          </div>
        </div>

        <dl class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-3">
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('recurring_incomes.amount_per_payment') %></dt>
            <dd class="mt-1 text-2xl font-semibold text-slate-900"><%= format_currency(@recurring_income.amount) %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('recurring_incomes.annual_amount') %></dt>
            <dd class="mt-1 text-2xl font-semibold text-blue-700"><%= format_currency(@recurring_income.annual_amount) %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('recurring_incomes.total_received') %></dt>
            <dd class="mt-1 text-2xl font-semibold text-green-700"><%= format_currency(@recurring_income.total_received) %></dd>
          </div>
        </dl>

        <dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 mt-6 pt-6 border-t border-slate-200">
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('recurring_incomes.payments_count') %></dt>
            <dd class="mt-1 text-lg font-medium text-slate-900">
              <%= @recurring_income.payments_count %> <%= t('recurring_incomes.payments') %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('recurring_incomes.next_payment') %></dt>
            <dd class="mt-1 text-lg font-medium text-slate-900">
              <%= @recurring_income.next_payment_date ? l(@recurring_income.next_payment_date, format: :long) : t('recurring_incomes.no_next_payment') %>
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Dettagli -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200">
        <h2 class="text-lg font-medium text-slate-900"><%= t('recurring_incomes.details') %></h2>
      </div>
      <div class="px-6 py-5">
        <dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.recurring_income.income_type') %></dt>
            <dd class="mt-1 text-sm text-slate-900">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                <%= t("activerecord.enums.recurring_income.income_type.#{@recurring_income.income_type}") %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.recurring_income.frequency') %></dt>
            <dd class="mt-1 text-sm text-slate-900">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                <%= t("activerecord.enums.recurring_income.frequency.#{@recurring_income.frequency}") %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.recurring_income.start_date') %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @recurring_income.start_date ? l(@recurring_income.start_date, format: :long) : '-' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500"><%= t('activerecord.attributes.recurring_income.end_date') %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @recurring_income.end_date ? l(@recurring_income.end_date, format: :long) : t('recurring_incomes.ongoing') %></dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Note -->
    <% if @recurring_income.notes.present? %>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200">
          <h2 class="text-lg font-medium text-slate-900"><%= t('activerecord.attributes.recurring_income.notes') %></h2>
        </div>
        <div class="px-6 py-5">
          <p class="text-sm text-slate-700 whitespace-pre-wrap"><%= @recurring_income.notes %></p>
        </div>
      </div>
    <% end %>

    <!-- Timestamps -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4">
        <dl class="grid grid-cols-1 gap-x-6 gap-y-2 sm:grid-cols-2 text-xs text-slate-500">
          <div>
            <dt class="inline"><%= t('shared.created_at') %>:</dt>
            <dd class="inline ml-1"><%= l(@recurring_income.created_at, format: :long) %></dd>
          </div>
          <div>
            <dt class="inline"><%= t('shared.updated_at') %>:</dt>
            <dd class="inline ml-1"><%= l(@recurring_income.updated_at, format: :long) %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <div class="mt-6">
    <%= link_to t('shared.back'), beneficiary_path(@beneficiary), class: 'text-blue-700 hover:text-blue-800 font-medium' %>
  </div>
</div>
