<%= form_with model: [ @beneficiario, @procedimento, istanza ], class: "space-y-6" do |f| %>
  <%= render "shared/errors", record: istanza %>
  <div class="card p-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="sm:col-span-2">
        <%= f.label :oggetto, "Oggetto *", class: "form-label" %>
        <%= f.text_field :oggetto, class: "form-input" %>
      </div>
      <div>
        <%= f.label :tipo, "Tipo", class: "form-label" %>
        <%= f.select :tipo, opzioni(Istanza::TIPI), { include_blank: "—" }, class: "form-input" %>
      </div>
      <div>
        <%= f.label :stato, "Stato", class: "form-label" %>
        <%= f.select :stato, opzioni(Istanza::STATI), {}, class: "form-input" %>
      </div>
      <div>
        <%= f.label :data_deposito, "Data deposito", class: "form-label" %>
        <%= f.date_field :data_deposito, class: "form-input" %>
      </div>
      <div>
        <%= f.label :data_decisione, "Data decisione", class: "form-label" %>
        <%= f.date_field :data_decisione, class: "form-input" %>
      </div>
      <div>
        <%= f.label :importo, "Importo (€)", class: "form-label" %>
        <%= f.number_field :importo, step: 0.01, min: 0, class: "form-input" %>
      </div>
    </div>
    <div>
      <%= f.label :esito, "Esito / provvedimento", class: "form-label" %>
      <%= f.text_area :esito, rows: 2, class: "form-input" %>
    </div>
    <div>
      <%= f.label :note, "Note", class: "form-label" %>
      <%= f.text_area :note, rows: 3, class: "form-input" %>
    </div>
  </div>
  <div class="flex justify-end space-x-3">
    <%= link_to "Annulla", beneficiario_procedimento_path(@beneficiario, @procedimento), class: "btn-secondary" %>
    <%= f.submit istanza.new_record? ? "Crea Istanza" : "Salva Modifiche", class: "btn-primary" %>
  </div>
<% end %>
