# See https://help.github.com/articles/ignoring-files for more about ignoring files.
/.bundle
/config/master.key
/config/credentials/*.key
/.env*

/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/storage/*
!/storage/.keep

/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
